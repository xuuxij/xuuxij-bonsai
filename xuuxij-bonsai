class Cloud:
    __slots__ = ("kind", "size", "depth", "behind", "rows", "paint", "alt", "alt_paint", "x", "y", "speed",
                 "born", "life", "phase", "phase_at", "fade", "ends", "breath_at", "width")

    def __init__(self, kind, text, paint, x, y, speed, born, life, fade, ends, alt=None, alt_paint=None):
        self.kind, self.size, self.rows, self.paint = kind, None, text, paint
        self.depth = "near"       # the tonal set's far, mid or near: its tones and pace
        self.behind = False       # passes behind the mountains (drawn on open sky only)
        self.alt, self.alt_paint = alt, (alt_paint or (paint_for(alt, _heap) if alt else None))
        self.x, self.y, self.speed, self.born, self.life, self.fade = float(x), y, speed, born, life, fade
        self.ends = ends          # "edge": comes and goes by the screen's edge; "fade": forms and dissolves
        self.phase, self.phase_at = ("in" if ends == "fade" else "on"), born
        self.breath_at = born + 25
        self.width = max(len(r) for r in text)


class Sky:
    FADE = {"cirrus": 40, "mackerel": 60, "lenticular": 30, "cumulus": 45, "mist": 40}
    LEVELS = {("W", 2): "W", ("W", 1): "g", ("W", 0): "d", ("c", 2): "c", ("c", 1): "g", ("c", 0): "d",
              ("g", 2): "g", ("g", 1): "g", ("g", 0): "d",
              ("d", 2): "d", ("d", 1): "d", ("d", 0): "d"}

    # The tonal set's depths: rows (shares of the height) by kind, speeds (columns a second
    # at 135 columns), the chance of passing behind the summits, how many at once.
    TONAL = {
        "far":  {"rows": {"cumulus": (0.03, 0.20), "cirrus": (0.02, 0.16), "mackerel": (0.06, 0.22)},
                 "speed": {"cumulus": (0.09, 0.09, 0.09), "cirrus": 0.06, "mackerel": 0.10},
                 "behind": {"cumulus": 0.5, "cirrus": 0.6, "mackerel": 0.5}, "at_once": 3},
        "mid":  {"rows": {"cumulus": (0.14, 0.30), "lenticular": (0.14, 0.26)},
                 "speed": {"cumulus": (0.20, 0.30, 0.30), "lenticular": 0.0},
                 "behind": {"cumulus": 0.2, "lenticular": 0.5}, "at_once": 2},
        "near": {"rows": {"cumulus": (0.25, 0.42), "roll": (0.30, 0.45)},
                 "speed": {"cumulus": (0.45, 0.45, 0.55), "roll": 0.50}, "behind": {}, "at_once": 1},
    }

    def __init__(self, scr, rng, attrs):
        self.scr, self.rng, self.attrs = scr, rng, attrs
        self.H, self.W = scr.getmaxyx()
        self.backdrop = None  # the landscape the clouds drift over, if there is one
        self.set = "ink"      # the cloud set: "ink" (drawn outlines) or "tonal" (shaded masses with depth)
        self.light = -1       # the light's side, the landscape's: -1 from the left, +1 from the right
        self.amount = {"far": 2.0, "mid": 1.0, "near": 1.0}  # how many of each depth, against the design
        self.wind = rng.choice((-1, 1))
        self.clouds = []
        self.frame = {}         # (y, x) -> (char, attr) as drawn now
        self.events = []        # (time, kind, size, depth) still to be born this tree
        self.tree_start = None
        self.floor = self.H - 1  # the row the mist must keep clear of (the planter's rim)
        self.last_draw = None
        self.empty_since = None  # when the sky last became empty
        self.rolled = False      # a stratocumulus roll has come this tree (one at most)
        self.mood = "fair"

    # ---- a tree's sky --------------------------------------------------------------------

    def new_tree(self, now, cycle, floor):
        """Draws the mood of the sky for this tree and the clouds it will bring."""
        rng = self.rng
        self.tree_start, self.floor = now, floor
        if not self.clouds and rng.random() < 0.2:
            self.wind = -self.wind  # the wind turns only over an empty sky
        span = cycle if cycle else 600.0
        self.mood = rng.choices(("clear", "fair", "high", "misty"), (20, 50, 15, 15))[0]
        self.rolled = False
        if self.set == "tonal":
            self.events = sorted(((now + t, k, s, d) for t, d, k, s in self.plan_tonal(span)), key=lambda e: e[0])
            return
        events = []
        cirrus = {"clear": rng.randint(1, 2), "fair": 1, "high": 2, "misty": rng.randint(0, 1)}[self.mood]
        cirrus = int(cirrus * self.amount["far"] + rng.random())  # the far setting counts here too
        for i in range(cirrus):
            size = (2, 1)[i % 2] if self.mood == "high" else rng.choice((0, 1, 1, 2))
            events.append((rng.uniform(0, span * 0.7), "cirrus", size))
        if self.mood == "fair":
            t = rng.uniform(10, 90)
            while t < span:
                events.append((t, "cumulus", None))
                t += rng.uniform(90, 150)
        elif self.mood == "clear":
            for _ in range(rng.randint(1, 2)):
                events.append((rng.uniform(0, span * 0.8), "cumulus", None))
        elif self.mood == "misty" and rng.random() < 0.5:
            events.append((rng.uniform(0, span * 0.8), "cumulus", None))
        if self.mood == "high" and rng.random() < 0.7:
            events.append((rng.uniform(0, span * 0.3), "mackerel", None))
        if self.mood != "misty" and rng.random() < 1 / 12:
            events.append((rng.uniform(0, span * 0.5), "lenticular", None))
        mists = rng.randint(1, 2) if self.mood == "misty" else (1 if rng.random() < 0.1 else 0)
        for _ in range(mists):
            events.append((rng.uniform(0, span * 0.6), "mist", None))
        self.events = sorted(((now + t, k, s, None) for t, k, s in events), key=lambda e: e[0])

    def plan_tonal(self, span):
        """The tonal set's clouds for one tree, by mood: (time, depth, kind, size). Far
        clouds are most of them, near ones rare; a high sky is cirrus and mackerel with
        nothing near; a misty one is mist and at most one far cloud."""
        rng = self.rng

        def at(lo=0.0, hi=0.8):
            return rng.uniform(lo * span, hi * span)

        def n(base, depth):  # the design's count, scaled by the setting for that depth
            return int(base * self.amount[depth] + rng.random())
        ev = []
        if self.mood == "clear":
            for _ in range(n(rng.randint(1, 2), "far")):
                ev.append((at(), "far", rng.choice(("cirrus", "cumulus", "cumulus")), None))
            for _ in range(n(0.5, "mid")):
                ev.append((at(), "mid", "cumulus", None))
        elif self.mood == "fair":
            for _ in range(n(3, "far")):
                ev.append((at(), "far", rng.choice(("cirrus", "cumulus", "cumulus", "mackerel")), None))
            for _ in range(n(2, "mid")):
                ev.append((at(), "mid", "lenticular" if rng.random() < 1 / 6 else "cumulus", None))
            for _ in range(n(rng.randint(1, 2), "near")):
                ev.append((at(0.0, 0.7), "near", "cumulus", None))
        elif self.mood == "high":
            for i in range(n(2, "far")):
                ev.append((at(0.0, 0.5 if i == 0 else 0.8), "far", "cirrus", (2, 1)[i % 2]))
            for _ in range(n(0.7, "far")):
                ev.append((at(0.0, 0.3), "far", "mackerel", None))
            for _ in range(n(0.5, "mid")):
                ev.append((at(), "mid", "cumulus", None))
        else:  # misty
            for _ in range(rng.randint(1, 2)):
                ev.append((at(0.0, 0.6), "far", "mist", None))
            for _ in range(n(0.5, "far")):
                ev.append((at(), "far", rng.choice(("cirrus", "cumulus")), None))
        if self.mood != "misty" and rng.random() < 0.1:
            ev.append((at(0.0, 0.6), "far", "mist", None))
        return ev

    def rows_for(self, kind, size):
        lo, hi = {"cirrus": (0.02, 0.16), "mackerel": (0.06, 0.22), "lenticular": (0.14, 0.26),
                  "cumulus": ((0.10, 0.32), (0.18, 0.40), (0.24, 0.46))[size or 0],
                  "roll": (0.30, 0.48), "mist": (0.52, 0.78)}[kind]
        return int(lo * self.H), int(hi * self.H)

    def birth(self, now, kind, size, ends=None, depth=None):
        """A new cloud of the kind, placed on free rows, by the edge or in place."""
        if self.set == "tonal":
            return self.birth_tonal(now, kind, size, depth or "far", ends)
        rng, W = self.rng, self.W
        scale = W / 135.0
        alt = None
        if kind == "cumulus":
            size = rng.choice((0, 0, 1, 1, 1, 2)) if size is None else size
            if (ends is None and rng.random() < 0.2 and not self.rolled
                    and not any(c.kind == "roll" for c in self.clouds)):
                kind, self.rolled = "roll", True  # the biggest shape: one per tree, one at a time
        elif kind == "cirrus":  # two cirrus in the sky are never the same size
            others = {c.size for c in self.clouds if c.kind == "cirrus"}
            if size in others and len(others) < 3:
                size = rng.choice([s for s in (0, 1, 2) if s not in others])
        if kind == "cumulus":
            _s, a, b = CLOUD_SHAPES["cumulus"][size]
            text, alt = (a, b) if rng.random() < 0.5 else (b, a)
            if self.wind < 0:
                text, alt = mirrored(text), mirrored(alt)
            if self.backdrop:
                text, alt = heap_fill(text), heap_fill(alt)
            paint = paint_for(text, _heap)
            speed = (0.30, 0.40, 0.50)[size] * scale
            ends = ends or ("edge" if (size == 2 or rng.random() < 0.6) else "fade")
            life = rng.uniform(180, 300)
        elif kind == "cirrus":
            text = CLOUD_SHAPES["cirrus"][size][1]
            if self.wind > 0:
                text = mirrored(text)
            paint = paint_for(text, _cirrus)
            speed, ends, life = 0.08 * scale, "fade", rng.uniform(180, 360)
        elif kind == "mackerel":
            text, paint = mackerel_field(rng)
            speed, ends, life = 0.12 * scale, "fade", rng.uniform(240, 360)
        elif kind == "lenticular":
            text = CLOUD_SHAPES["lenticular"]
            paint = paint_for(text, _heap)
            speed, ends, life = 0.0, "fade", rng.uniform(180, 300)
        elif kind == "roll":
            text, paint = stratocumulus_roll(rng)
            speed, ends, life = 0.45 * scale, "edge", 0
        else:  # mist
            text, paint = mist_band(rng, rng.randint(min(40, W), max(min(40, W), int(0.6 * W))))
            speed, ends, life = 0.0, "fade", rng.uniform(120, 240)
        lo, hi = self.rows_for(kind, size)
        self.place(now, kind, size, text, paint, speed, ends, life, lo, hi, alt)

    def birth_tonal(self, now, kind, size, depth, ends=None):
        """A cloud of the tonal set: shaped for its depth, lit from the landscape's side,
        paced and placed by its depth, behind the summits now and then."""
        rng, W, light = self.rng, self.W, self.light
        scale = W / 135.0
        depth = {"cirrus": "far", "mackerel": "far", "lenticular": "mid", "roll": "near", "mist": "far"}.get(kind, depth)
        if kind != "mist" and sum(1 for c in self.clouds if c.depth == depth and c.kind != "mist") \
                >= self.at_once(depth):
            return
        alt = alt_paint = None
        if kind == "cumulus":
            if size is None:
                size = {"far": 0, "mid": rng.choice((0, 1)), "near": (1 if rng.random() < 2 / 3 else 2)}[depth]
            if (depth == "near" and ends is None and rng.random() < 0.2 and not self.rolled
                    and not any(c.kind == "roll" for c in self.clouds)):
                kind, self.rolled = "roll", True
        if kind == "cumulus":
            (text, paint), (alt, alt_paint) = tc_pair(size, depth, rng, light)
            speed = self.TONAL[depth]["speed"]["cumulus"][size] * scale
            ends = ends or ("edge" if (size == 2 or rng.random() < 0.6) else "fade")
            life = rng.uniform(180, 300)
        elif kind == "cirrus":
            size = rng.choice((0, 1, 1, 2)) if size is None else size
            text, paint = tc_cirrus(size, "far", rng, light)
            if self.wind > 0:
                text, paint = mirrored(text), [r[::-1] for r in paint]
            speed, ends, life = 0.06 * scale, "fade", rng.uniform(180, 360)
        elif kind == "mackerel":
            text, paint = tc_mackerel("far", rng, light)
            speed, ends, life = 0.10 * scale, "fade", rng.uniform(240, 360)
        elif kind == "lenticular":
            text, paint = tc_lenticular("mid", rng, light)
            speed, ends, life = 0.0, "fade", rng.uniform(180, 300)
        elif kind == "roll":
            text, paint = tc_roll(rng.randint(34, 58), "near", rng, light)
            speed, ends, life = 0.50 * scale, "edge", 0
        else:  # mist
            text, paint = tc_mist(rng.randint(min(40, W), max(min(40, W), int(0.6 * W))), "far", rng, light)
            speed, ends, life = 0.0, "fade", rng.uniform(120, 240)
        if kind == "mist":
            lo, hi = self.rows_for(kind, size)
        else:
            lo, hi = (int(v * self.H) for v in self.TONAL[depth]["rows"][kind])
        cloud = self.place(now, kind, size, text, paint, speed, ends, life, lo, hi, alt, alt_paint)
        if cloud:
            cloud.depth = depth
            cloud.behind = kind != "mist" and rng.random() < self.TONAL[depth]["behind"].get(kind, 0)

    def at_once(self, depth):
        """How many clouds of a depth may be in the sky together: the design's count,
        scaled by the setting for that depth."""
        return max(1, int(round(self.TONAL[depth]["at_once"] * self.amount[depth])))

    def place(self, now, kind, size, text, paint, speed, ends, life, lo, hi, alt=None, alt_paint=None):
        """Puts a new cloud on free rows between lo and hi, by the upwind edge or in a
        place its life's drift keeps in view; returns it, or None when there is no room."""
        rng, W = self.rng, self.W
        width = max(len(r) for r in text)
        if width > W:
            return None
        if kind == "mist":
            hi = min(hi, self.floor - 7 - len(text))
            if hi < lo:
                return None
        for _try in range(6):
            y = rng.randint(lo, max(lo, hi))
            if ends == "edge":
                x = -width if self.wind > 0 else W
            elif width + 20 > W:
                x = (W - width) // 2
            else:  # forms where its life's drift keeps it in view
                drift = min(W - width - 20, int(speed * (life + self.FADE.get(kind, 40))))
                lo_x, hi_x = (10, W - width - 10 - drift) if self.wind > 0 else (10 + drift, W - width - 10)
                x = rng.randint(lo_x, max(lo_x, hi_x))
            if not any(abs(c.y - y) < max(len(c.rows), len(text)) and c.x - 8 < x + width and x - 8 < c.x + c.width
                       for c in self.clouds):
                cloud = Cloud(kind, text, paint, x, y, speed * self.wind, now, life,
                              self.FADE.get(kind, 40), ends, alt, alt_paint)
                cloud.size = size
                self.clouds.append(cloud)
                return cloud
        return None

    # ---- time -------------------------------------------------------------------------------

    def tick(self, now, grid, busy=(), draw=True):
        """Moves the sky to `now` and draws what changed, where nothing else is: not
        over the tree, the planter or the carpet (`grid`), nor a leaf in the air
        (`busy`)."""
        if draw and self.last_draw is not None and now - self.last_draw < SKY_TICK:
            return
        rng = self.rng
        most = 5 if self.set == "ink" else 1 + sum(self.at_once(d) for d in ("far", "mid", "near"))
        while self.events and self.events[0][0] <= now:
            _t, kind, size, depth = self.events.pop(0)
            if len(self.clouds) < most:
                self.birth(now, kind, size, depth=depth)
        kept = []
        for c in self.clouds:
            if self.last_draw is not None:
                c.x += c.speed * (now - self.last_draw)
            age = now - c.born
            if c.phase == "in" and age >= c.fade:
                c.phase, c.phase_at = "on", now
            if c.phase == "on" and c.ends == "fade" and age >= c.life:
                c.phase, c.phase_at = "out", now
            if c.phase == "out" and now - c.phase_at >= c.fade:
                continue  # gone
            if c.ends == "edge" and (c.x > self.W + 2 or c.x + c.width < -2) and age > 5:
                continue  # drifted off
            if c.alt and now >= c.breath_at:  # a cumulus breathes: one hump grows, then settles
                c.rows, c.alt = c.alt, c.rows
                c.paint, c.alt_paint = c.alt_paint, c.paint
                c.width = max(len(r) for r in c.rows)
                c.breath_at = now + rng.uniform(25, 45)
            kept.append(c)
        self.clouds = kept
        if kept:
            self.empty_since = None
        elif self.empty_since is None:
            self.empty_since = now
        elif now - self.empty_since >= 90:  # never an empty sky for long, whatever the mood
            self.birth(now, "cumulus" if rng.random() < 2 / 3 else "cirrus", 0, ends="fade", depth="far")
            self.empty_since = None
        self.last_draw = now
        if not draw:
            return
        frame = {}
        for c in self.clouds:
            p = 1.0
            if c.phase == "in":
                p = (now - c.born) / c.fade
            elif c.phase == "out":
                p = 1.0 - (now - c.phase_at) / c.fade
            x0 = int(round(c.x))
            if self.set == "tonal":  # the whole mass fades together, each cell re-stepped on its ladder
                rows, paint = c.rows, c.paint
                if p < 1.0:
                    rows, paint = tc_fade(rows, paint, max(0.0, p), TC_DEPTHS[c.depth]["solid"])
                for dy, (row, prow) in enumerate(zip(rows, paint)):
                    for dx, (ch, pt) in enumerate(zip(row, prow)):
                        if pt == " ":
                            continue
                        y, x = c.y + dy, x0 + dx
                        if not (0 <= y < self.H and 0 <= x < self.W):
                            continue
                        if c.behind and self.backdrop and self.backdrop.layer[y][x] not in " C":
                            continue  # passing behind the mountains
                        frame[(y, x)] = (ch, self.attrs[pt])
                continue
            for dy, (row, paint) in enumerate(zip(c.rows, c.paint)):
                for dx, (ch, pt) in enumerate(zip(row, paint)):
                    if pt == " ":
                        continue
                    # Each cell has its moment in a fade: a cirrus from the head, its
                    # tail last to come and first to go; a cumulus from its middle out.
                    f = dx / max(1, c.width - 1)
                    if c.kind == "cirrus" and self.wind > 0:
                        f = 1 - f
                    if c.kind not in ("cirrus", "mist"):
                        f = abs(f - 0.5) * 2
                    level = 2 if p >= 0.5 * f + 0.5 else 1 if p >= 0.5 * f + 0.25 else 0 if p >= 0.5 * f else -1
                    if level < 0:
                        continue
                    y, x = c.y + dy, x0 + dx
                    if not (0 <= y < self.H and 0 <= x < self.W):
                        continue
                    if c.behind and self.backdrop and self.backdrop.layer[y][x] not in " C":
                        continue  # passing behind the mountains
                    frame[(y, x)] = (ch, self.attrs[self.LEVELS[(pt, level)]])
        for cell in self.frame:
            if cell not in frame and cell not in grid and cell not in busy:
                if self.backdrop:
                    self.put_raw(cell, *self.backdrop.cell(*cell))
                else:
                    self.put(cell, " ", 0)
        for cell, (ch, attr) in frame.items():
            if self.frame.get(cell) != (ch, attr) and cell not in grid and cell not in busy:
                self.put(cell, ch, attr)
        self.frame = frame

    def put(self, cell, ch, attr):
        if self.backdrop:  # over the landscape's own background there
            attr = PAIRS.on(attr, self.backdrop.bg[cell[0]][cell[1]])
        self.put_raw(cell, ch, attr)

    def setup(self, cfg, backdrop):
        """The cloud set and the light for this run: the tonal set over a landscape (or
        when asked for), the ink set on a black sky; the light from the landscape's side."""
        self.backdrop = backdrop
        self.set = "tonal" if cfg["clouds"] == "tonal" or (cfg["clouds"] == "auto" and backdrop) else "ink"
        self.light = backdrop.meta["profiles"]["light"] if backdrop else -1
        self.amounts(cfg)

    def amounts(self, cfg):
        """How many clouds of each depth, from the settings (read again for every tree)."""
        self.amount = {d: cfg[f"clouds_{d}"] for d in ("far", "mid", "near")}

    def put_raw(self, cell, ch, attr):
        try:
            self.scr.addstr(cell[0], cell[1], ch, attr)
        except curses.error:
            pass

    def cell(self, cell):
        """What the sky shows at `cell`, for putting back under a passing leaf."""
        return self.frame.get(cell)

    def redraw(self, grid):
        """Draws the whole sky again (after the screen was cleared)."""
        for cell, (ch, attr) in self.frame.items():
            if cell not in grid:
                self.put(cell, ch, attr)


class Stroke:
    """One line of the drawing: a trunk, a branch, or a cloud of foliage."""
    __slots__ = ("kind", "cells", "after", "pos", "lit", "cover")

    def __init__(self, kind):
        self.kind = kind
        self.cells = []      # (y, x, text, attr) in drawing order; wood's attr is None
        self.after = []      # strokes queued when this one finishes
        self.pos = 0
        self.lit = None      # the cell drawn bright until the tip moves on
        self.cover = set()   # cells of this twig its own cloud may grow over


TRUNK_KINDS = ("trunk", "twin", "fall", "root", "rock")
BRANCH_KINDS = ("primary", "secondary", "fallb", "jin")
CASCADES = ("kengai", "hankengai")  # the forms with their own planner, laid out over the planter


class Tree:
    def __init__(self, scr, cfg, rng, attrs, inherit=None):
        """A new tree. With `inherit` (the planter and the screen's grid of the tree
        before it) it grows in the same planter, out of the carpet the last one left."""
        self.scr, self.cfg, self.rng, self.attrs = scr, cfg, rng, attrs
        self.H, self.W = scr.getmaxyx()
        self.sky = None  # the sky behind the tree, set by the screensaver loop
        self.backdrop = None  # the landscape behind the sky, likewise
        self.ink = set()  # the trunk's inside: drawn on black over a landscape
        self.busy = set()  # cells a leaf or dust in the air is passing, kept from the sky
        self.cx = self.W // 2  # the base's column while planning; the composition is placed after
        self.air = min(AIR_ABOVE, max(3, self.H // 9))   # rows kept clear above the apex
        self.margin = min(MARGIN, max(2, self.W // 13))  # columns kept clear at each side
        self.trunk_done = None
        self.report = {}
        self.planter = inherit["planter"] if inherit else None
        # What the screen holds, for drawing things over it and putting it back:
        # (y, x) -> ("wood", char, attr) | ("leaf", char, attr, what was under it)
        #           | ("pot", char, attr) | ("soil", char, attr)
        #           | ("fallen" | "dust", char, attr, what was under it)
        self.grid = inherit["grid"] if inherit else {}
        # The form, the twin, the leaf set, the planter: drawn once per tree.
        self.style = cfg["style"] if cfg["style"] != "auto" else self.draw_style()
        self.spec = USER_FORMS.get(self.style) or FORMS.get(self.style)
        self.twin = self.style == "moyogi" and (cfg["twin"] == "yes"
                                                or (cfg["twin"] == "auto" and rng.random() < 0.2))
        # The foliage, the bark and the deadwood: drawn to suit the form.
        self.foliage = self.draw_foliage()
        self.bark = self.draw_bark()
        self.deadwood = self.draw_deadwood()
        self.topjin = self.deadwood and self.style in ("bunjin", "fukinagashi") and rng.random() < 0.5
        self.accents = {}  # a leaf cell that is a bloom, a bud or a fruit
        self.jins = []
        inside = FOLIAGE[self.foliage]["inside"]
        if cfg["leaves"] != "auto":
            self.leaf_set = cfg["leaves"]
        elif self.spec and "leaves" in self.spec:
            self.leaf_set = self.spec["leaves"]
        elif inside is None:
            self.leaf_set = self.draw_leaves()
        else:
            self.leaf_set = inside
        default_edge = SETTINGS["leaf_edge"][0]
        self.leaf_edge = cfg["leaf_edge"] if cfg["leaf_edge"] != default_edge else FOLIAGE[self.foliage]["edge"]
        if self.planter:
            self.pot_kind, self.stand_kind = self.planter[0], self.planter[1]
        else:
            self.pot_kind, self.stand_kind = self.pot_for()
            if self.H < 45 or self.W < 50:
                self.pot_kind, self.stand_kind = "no", None  # no room for a planter
            elif self.H < 80 and self.stand_kind and self.style != "kengai":
                self.stand_kind = None  # a short screen: the planter without its stand
        total = block_height(self.pot_kind, self.stand_kind) if self.pot_kind != "no" else 0
        self.base = self.H - total + 1 if self.pot_kind != "no" else self.H - 1
        self.report.update({"style": self.style, "twin": self.twin, "leaves": self.leaf_set,
                            "foliage": self.foliage, "bark": self.bark, "deadwood": self.deadwood,
                            "planter": f"{self.pot_kind} on {self.stand_kind or 'no stand'}"
                                       + (" (kept)" if self.planter else "")})
        if self.style in CASCADES:
            self.first_side = rng.choice((-1, 1))  # the fall side, needed before planning
            if self.planter:  # the cascade is planned in place over the planter it has
                _k, _s, width, x0, _sw, _sx0 = self.planter
                self.cx = x0 + self.planting_offset(width)
        # Plan, lay the planter out, and place the whole composition: centred on the
        # screen, or over the planter it inherits; if it will not fit between the
        # margins, plan it again narrower with the same dice.
        state = rng.getstate()
        shrink = 1.0
        for _attempt in range(6):
            rng.setstate(state)
            self.plan(shrink)
            if self.style not in CASCADES:
                self.layout_pot()
            if self.planter and self.style not in CASCADES:
                _k, _s, width, x0, _sw, _sx0 = self.planter
                self.translate(x0 + self.planting_offset(width) - self.cx)
            lo, hi = self.composition_box()
            if hi - lo + 1 <= self.W - 2 * self.margin and (not self.planter or (lo >= 0 and hi < self.W)):
                break
            shrink *= 0.9
        if not self.planter:
            self.translate((self.W - 1 - lo - hi) // 2)
        lo, hi = self.composition_box()
        self.report["composition"] = f"columns {lo} to {hi} (centre {(lo + hi) / 2:.1f} of {(self.W - 1) / 2})"

    def planter_spec(self):
        """What the next tree needs to grow in this planter."""
        if not self.pot_rows:
            return None
        x0 = self.pot_rows[0][0]
        stand = [r for r in self.pot_rows if r[3]]
        return (self.pot_kind, self.stand_kind, self.pot_width, x0,
                len(stand[0][1]) if stand else 0, stand[0][0] if stand else 0)

    # ---- the draws -----------------------------------------------------------------------

    def draw_style(self):
        weights = {}
        for item in self.cfg["styles"].split():
            name, _sep, number = item.partition(":")
            weights[name] = int(number)
        if self.cfg["stand"] == "no" or self.cfg["pot"] == "no" or self.H < 100:
            weights["kengai"] = 0  # a cascade needs its tall stand, and the height to hang beside it
        if self.cfg["pot"] == "no" or self.H < 80:
            weights["hankengai"] = 0  # a semi-cascade needs a planter's body to run down beside
        for name, spec in USER_FORMS.items():  # the user's forms join the draw by their weight
            weights.setdefault(name, spec.get("weight", 10))
        if self.planter:  # the forms that suit the planter already standing there
            if self.planter[1] == "cascade":
                weights = {"kengai": weights.get("kengai", 10) or 10, "bunjin": weights.get("bunjin", 0)}
            else:
                weights["kengai"] = 0
        names = [n for n in list(STYLES) + list(USER_FORMS) if weights.get(n, 0) > 0] or ["moyogi"]
        return self.rng.choices(names, [weights.get(n, 1) for n in names])[0]

    def draw_leaves(self):
        return self.rng.choices([s for s, _w in LEAF_SETS], [w for _s, w in LEAF_SETS])[0]

    def draw_from(self, table, names):
        """One name from a weights table (a dict, a "name:weight" string or a name)."""
        if isinstance(table, str) and ":" not in table:
            table = {table: 1}
        elif isinstance(table, str):
            table = {item.partition(":")[0]: int(item.partition(":")[2]) for item in table.split()}
        picks = [n for n in table if n in names and table[n] > 0]
        return self.rng.choices(picks, [table[n] for n in picks])[0] if picks else None

    def draw_foliage(self):
        cfg = self.cfg
        if cfg["foliage"] != "auto":
            return cfg["foliage"]
        table = cfg["foliages"] if cfg["foliages"] != "auto" else \
            (self.spec.get("foliage") if self.spec else None) or FOLIAGE_BY_FORM.get(self.style) or {"cloud": 1}
        return self.draw_from(table, FOLIAGE) or "cloud"

    def draw_bark(self):
        """The bark to suit the form, among those its foliage allows."""
        cfg = self.cfg
        if cfg["bark"] != "auto":
            return cfg["bark"]
        table = cfg["barks"] if cfg["barks"] != "auto" else \
            (self.spec.get("bark") if self.spec else None) or BARK_BY_FORM.get(self.style) or {"smooth": 1}
        allowed = BARK_BY_FOLIAGE.get(self.foliage, "smooth").split()
        for _try in range(6):
            bark = self.draw_from(table, BARKS)
            if bark in allowed:
                return bark
        return "smooth"

    def draw_deadwood(self):
        cfg = self.cfg
        if cfg["deadwood"] == "yes":
            return True
        if cfg["deadwood"] == "no" or self.foliage not in CONIFERS or self.bark in ("rough", "hollow"):
            return False
        chance = (self.spec.get("deadwood") if self.spec else None)
        if not isinstance(chance, (int, float)):
            chance = DEADWOOD_BY_FORM.get(self.style, 0.0)
        return self.rng.random() < chance

    def pot_for(self):
        """The planter and stand for this form (a forced pot wins; the stand setting
        wins over the form's choice)."""
        cfg, rng = self.cfg, self.rng
        if cfg["pot"] == "no":
            return "no", None
        wanted = self.spec.get("planter", "wide") if self.spec else "wide"
        if cfg["pot"] != "auto":
            kind = cfg["pot"]
            stand = "tall" if kind == "bunjin" else None
            if self.style == "kengai":
                stand = "cascade"
        # The planter stands for the whole run, so it follows the owner's taste
        # (2026-10-20: "big, wide, ornate ... like the big Japanese-style ones"), not
        # the first tree's form: the rectangle or the oval, on a stand half the time.
        # The narrow pots come only when named in the settings; the cascade's is its own.
        elif self.style == "kengai":
            kind, stand = "hexagon", "cascade"
        elif wanted != "wide":  # a user's form asked for a planter by name
            kind = wanted
            stand = "tall" if kind == "bunjin" else ("stand" if rng.random() < 0.5 else None)
        else:
            kind = rng.choice(("teizan", "oval"))
            stand = "stand" if rng.random() < 0.5 else None
        if cfg["stand"] == "no" and self.style != "kengai":
            stand = None
        elif cfg["stand"] == "yes" and stand is None:
            stand = "tall" if kind == "bunjin" else "stand"
        return kind, stand

    def draw_for_forms(self, key, draw):
        """One draw per built-in form, in a fixed order, then the user's own form's if
        this is one: so a seed gives the same tree whichever form it lands on, and the
        built-in trees never change under a new form."""
        draws = {name: draw(FORMS[name][key]) for name in ("moyogi", "chokkan", "shakan", "bunjin")}
        if self.style in draws:
            return draws[self.style]
        return draw(self.spec[key])

    @property
    def s_share(self):
        """The form's spread share, drawn once (kept on the instance)."""
        if not hasattr(self, "_s_share"):
            self._s_share = self.draw_for_forms("spread", lambda v: rng_range(self.rng, v)) if self.spec else 0.0
        return self._s_share

    # ---- planning ------------------------------------------------------------------------

    def plan(self, shrink):
        cfg, rng = self.cfg, self.rng
        self.strokes, self.wood, self.trunk_rows = [], {}, {}
        self.families, self.clouds = [], 0
        self.jins, self.accents = [], {}
        self.extra_trunks, self.legs, self.lift = [], [], 0  # the clump's other trunks; the root legs; rows they lift the trunk
        self.pot_rows, self.pot_spec, self.rim, self.stand_span, self.stand_top = [], None, None, None, None
        self.blocked, self.pot_cols = set(), set()
        B = self.base
        if self.style == "kengai":
            self.plan_kengai(shrink)
            return
        if self.style == "hankengai":
            self.plan_hankengai(shrink)
            return
        spec = self.spec
        r_share = self.draw_for_forms("height", lambda v: rng_range(rng, v))
        R = int(round(r_share * B * cfg["height"] / 0.6))
        R = max(10, min(R, B - self.air))
        # The spread follows the width budget, but never outgrows the tree's own height:
        # on a short, wide screen the tree keeps its shape and leaves the sides empty.
        S = int(round(self.s_share * cfg["width"] * self.W * shrink))
        S = max(16, min(S, int(1.5 * R)))
        self.R, self.S = R, S
        self.scale = min(1.0, R / DESIGN_ROWS)  # every proportion below shrinks with a small tree
        tw = spec["trunk_width"]
        if tw[0] == "drawn":
            w0 = rng.randint(tw[1], tw[2]) if R >= 30 else rng.randint(2, 3)
        else:
            w0 = max(tw[2], min(tw[3], round(R / tw[1])))
            w0 = max(3, int(round(w0 * self.scale)))
        self.w0 = w0
        s = rng.choice((-1, 1))  # the side of the trunk's first movement, or of the lean
        self.first_side = s
        if self.style == "hokidachi":
            self.plan_hokidachi(R, S, w0)
            return
        if spec.get("roots") == "stilts":  # the trunk's line starts above its root legs
            self.lift = max(3, int(round(rng_range(rng, spec["root_height"]) * R)))
            R = max(8, R - self.lift)
            self.R = R
        # The trunk's line.
        line = spec["line"]
        if line == "s-curve":
            A = rng_range(rng, spec["movement"])
            apex = rng_range(rng, spec["apex"])
            points = [(0, 0), (0.35 * R, s * A), (0.65 * R, -0.55 * s * A), (0.88 * R, 0.25 * s * A), (R, apex)]
        elif line == "straight":
            points = [(0, 0), (R, 0)]
        elif line == "lean":
            lean = rng_range(rng, spec["lean"]) * R * s * (shrink if spec.get("sides") == "lee" else 1.0)
            bow = rng_range(rng, spec["bow"])
            points = [(0, 0), (0.25 * R, lean * 0.25 - s * bow * 0.7), (0.5 * R, lean * 0.5 - s * bow),
                      (0.75 * R, lean * 0.75 - s * bow * 0.7), (R, lean)]
        else:  # literati
            A = rng_range(rng, spec["movement"])
            lean = s * rng_range(rng, spec["apex"])
            points = [(0, 0), (0.3 * R, s * A), (0.55 * R, -0.7 * s * A), (0.78 * R, 0.5 * s * A),
                      (0.92 * R, -0.3 * s * A), (R, lean)]
        points = [(int(round(r)), x) for r, x in points]
        path = gentle_path(points, 0, R)  # height above the soil -> x offset
        if line == "straight" and rng.random() < 0.5:
            h = rng.randint(R // 4, 3 * R // 4)
            path[h] += rng.choice((-1, 1))  # at most one wobble
        self.trunk_path = {B - self.lift - h: self.cx + x for h, x in path.items()}
        self.report.update({"R": R, "S": S, "w0": w0, "control points": [(h, round(x, 1)) for h, x in points],
                            "apex offset": path[R] - path[0]})
        nebari = spec["roots"]
        if nebari == "lean":  # three roots on the outer side of the lean, one inside
            nebari = ("___/", "\\_") if s > 0 else ("_/", "\\___")
        elif nebari == "stilts":
            nebari = None
        trunk = self.make_trunk("trunk", [(B - self.lift - h, self.cx + path[h]) for h in range(R + 1)], w0, nebari)
        if self.lift:
            self.plan_legs(w0)
        twin = self.plan_twin(trunk, R, S, w0, s) if self.twin else None
        if twin is not None:
            self.extra_trunks.append((twin, self.twin_path, self.twin_R, self.twin_side))
        for share, side_rule, wshare, lean in spec.get("trunks", ()):  # the clump's other trunks
            t = self.plan_twin(trunk, R, S, w0, s, fork=(1, 2), share=share, apex=lean, wshare=wshare,
                               side=-s if side_rule == "opposite_first_curve" else s)
            if t is not None:
                self.extra_trunks.append((t, self.twin_path, self.twin_R, self.twin_side))
        groups = self.plan_primaries(trunk, R, S, s)
        for i, (t, tpath, R2, s2) in enumerate(self.extra_trunks):
            count = 2 if t is twin else rng.randint(*spec["trunk_branches"])
            groups += self.plan_twin_primaries(t, S, R2, s2, tpath, count, 10 * (i + 1))
        self.plan_jins(trunk, R, groups)
        back = self.plan_back_pad(trunk, R, groups)
        self.plan_clouds(trunk, twin, groups, back)

    def make_trunk(self, kind, cells_xy, w0, nebari=None, taper_from=0, taper_total=None):
        """A trunk stroke along the rows of `cells_xy` (bottom first), tapering from w0
        at its start, its edges and inside in the tree's bark (smooth lines; plated
        brick; twisted grain that turns with the movement; rough flakes with a knothole;
        a hollow with its black void and ragged lips), a shari of bleached deadwood up
        the outside of the first curve when the tree has one, roots on the first row.
        A cell's paint: b bark on the ground, k the ink inside, v the void, d deadwood."""
        s = Stroke(kind)
        rng = self.rng
        n = len(cells_xy)
        total = taper_total or n
        bark = self.bark
        widths = [max(1, int(round(1 + (w0 - 1) * (1 - min(1.0, (taper_from + i) / max(1, total - 1))) ** 1.15)))
                  for i in range(n)]
        first_dx = next((cells_xy[i + 1][1] - cells_xy[i][1] for i in range(n - 1)
                         if cells_xy[i + 1][1] != cells_xy[i][1]), 1)
        shari_side = -1 if first_dx > 0 else 1  # the outside of the first curve
        shari_top = rng.uniform(0.55, 0.75) if (self.deadwood and kind == "trunk") else 0.0
        void = {i for i in range(n) if bark == "hollow" and widths[i] >= 5
                and 0.10 <= i / max(1, n - 1) < 0.45}  # of this stroke's own height
        uro_row = None
        if bark == "rough":
            wide = [i for i in range(n) if widths[i] >= 6 and 0.40 <= (taper_from + i) / max(1, total - 1) <= 0.55]
            uro_row = rng.choice(wide) if wide else None
        for i, (y, x) in enumerate(cells_xy):
            w = widths[i]
            share = (taper_from + i) / max(1, total - 1)
            dx = cells_xy[i + 1][1] - x if i + 1 < n else 0
            moving = dx != 0 and not (nebari and i < 2)
            diag = "/" if dx > 0 else "\\"
            if bark == "twisted" and not moving and w >= 4:  # narrower rows take smooth edges
                edge_l, edge_r = "(", ")"
            elif bark == "rough" and not moving and w >= 2:
                edge_l, edge_r = "{", "}"
            else:
                edge_l = edge_r = diag if moving else "|"
            core, paint = [], []
            for k in range(max(0, w - 2)):
                if bark == "plated":
                    ch = "|" if (k + i // 3) % 4 == 0 else "_"  # plates four wide, three rows tall
                elif bark == "twisted":
                    ch = diag if moving else ("(" if w >= 4 and (k - i) % 4 == 0 else "|")
                elif bark == "rough":
                    r = rng.random()
                    ch = "|" if r < 0.78 else "%" if r < 0.90 else ":"
                elif TRUNK_CORE == "shade":
                    ch = "▒"
                else:
                    ch = "|"
                core.append(ch)
                paint.append("k")
            if i in void:
                core = ["("] + [" "] * (w - 4) + [")"]
                paint = ["k"] + ["v"] * (w - 4) + ["k"]
            elif void and i == max(void) + 1 and w >= 3:
                core = ["'"] * (w - 2)
            elif void and i == min(void) - 1 and w >= 3:
                core = ["."] * (w - 2)
            if uro_row is not None and i == uro_row and len(core) >= 4:
                core[2:4] = ["(", ")"]  # the knothole (uro)
            edge_paint = ["b", "b"]
            if shari_top:  # the bleached strip: three cells at the base, thinning to the edge alone
                strip = 2 if share < 0.20 else 1 if share < 0.40 else 0
                for k in range(min(strip, len(core))):
                    kk = k if shari_side < 0 else len(core) - 1 - k
                    core[kk] = diag if moving else rng.choice("|:")  # the strip's own texture
                    paint[kk] = "d"
                if share < shari_top:
                    edge_paint[0 if shari_side < 0 else 1] = "d"
            if w >= 3:
                text = edge_l + "".join(core) + edge_r
                pnt = edge_paint[0] + "".join(paint) + edge_paint[1]
            elif w == 2:
                text, pnt = edge_l + edge_r, "".join(edge_paint)
            else:
                text, pnt = edge_l, edge_paint[0]
            x0 = x - w // 2
            if w >= 3 and TRUNK_CORE == "ink":  # the inside of the trunk: an ink mass with bark lines
                self.ink.update((y, cx) for cx in range(x0 + 1, x0 + w - 1))
            if i == 0 and nebari:
                left, right = nebari
                text, pnt, x0 = left + text + right, "b" * len(left) + pnt + "b" * len(right), x0 - len(left)
            if self.topjin and kind == "trunk" and i >= n - 3:  # the top jin: the apex died back
                pnt = "j" * len(text)
                if i == n - 1:
                    text = "'" * len(text)
            s.cells.append((y, x0, text, pnt))
            self.trunk_rows.setdefault(y, (x0, len(text)))
            if kind == "trunk":
                self.trunk_rows[y] = (x0, len(text))
            for k in range(len(text)):
                self.wood[(y, x0 + k)] = s
        self.strokes.append(s)
        return s

    def trunk_x_at(self, y):
        """The main trunk's centre column on row `y` (clamped to its ends)."""
        rows = sorted(self.trunk_path)
        y = max(rows[0], min(rows[-1], y))
        return self.trunk_path[y]

    def primary_heights(self, n, f1):
        """Shares of R where the main branches leave: f1, then gaps shrinking upward,
        the top one at 0.85."""
        weights = [1.25, 1.0, 0.85, 0.75, 0.70][: max(0, n - 1)]
        span = 0.85 - f1
        total = sum(weights) or 1
        heights, h = [f1], f1
        for w in weights:
            h += span * w / total
            heights.append(h)
        return heights

    def plan_primaries(self, trunk, R, S, s):
        cfg, rng, B = self.cfg, self.rng, self.base - self.lift
        spec = self.spec
        n = self.draw_for_forms("branches", lambda v: rng.randint(*v))
        f1 = self.draw_for_forms("first_branch", lambda v: rng_range(rng, v))
        heights = self.primary_heights(n, f1)
        either = rng.choice((-1, 1))  # drawn for every form, used when the first side is free
        first = {"outside": s, "away": -s, "with": s}.get(spec["first_side"]) or either
        L0 = S / 2 - 4
        groups, listing = [], []
        side = first
        twin_apex = min(self.twin_path) if self.twin and hasattr(self, "twin_path") else None
        for k, h in enumerate(heights):
            y = B - int(round(h * R))
            if y not in self.trunk_rows:
                continue
            if twin_apex is not None and y >= twin_apex - 4:
                side = -self.twin_side  # beside the twin, the branches go the other way
            x0, w = self.trunk_rows[y]
            start_x = x0 + w if side > 0 else x0 - 1
            least = max(4, int(round(10 * self.scale)))
            if spec["branch_length"] == "by_spread":
                length = max(least, int(round(L0 * (1 - spec.get("length_taper", 0.17) * k))))
            else:
                length = max(4, int(round(rng.randint(*spec["branch_length"]) * self.scale)))
            profile = spec["profile"]
            if self.foliage == "willow":
                profile = "droop"  # the cap hangs at the branch's lowest point
            elif self.foliage == "pine" and self.style == "chokkan" and rng.random() < 0.4:
                profile = "droop"  # old pines sag
            p = self.plan_branch("primary", y, start_x, side, length, profile)
            if p is not None:
                secs = self.plan_secondaries(p, side) if self.twigs_for() else []
                groups.append((p, secs, k))
                listing.append((round(h, 2), len(p.cells)))
            if spec.get("sides") != "lee":  # the windswept tree's branches all stream one way
                side = -side
        self.report["primaries (height share, length)"] = listing
        return groups

    def plan_jins(self, trunk, R, groups):
        """A jin or two when the tree has deadwood: a dead branch bleached white, three
        to six cells of -~-' at 55-70% of the trunk's height on a side with no live
        branch near, its last cell a row up; it draws right after the trunk."""
        if not self.deadwood:
            return
        rng, B = self.rng, self.base - self.lift
        taken = {}  # row -> the sides with a live branch within three rows
        for p, _secs, _k in groups:
            y0, x0 = p.cells[0][:2]
            side = 1 if y0 in self.trunk_rows and x0 >= self.trunk_rows[y0][0] + self.trunk_rows[y0][1] else -1
            for y in range(y0 - 3, y0 + 4):
                taken.setdefault(y, set()).add(side)
        for _j in range(1 + (rng.random() < 0.35)):
            for _try in range(8):
                y = B - int(round(rng.uniform(0.55, 0.70) * R))
                sides = [sd for sd in (-1, 1) if sd not in taken.get(y, ())]
                if y not in self.trunk_rows or not sides:
                    continue
                side = rng.choice(sides)
                x0, w = self.trunk_rows[y]
                x = x0 + w if side > 0 else x0 - 1
                length = rng.randint(3, 6)
                cells = []
                for k in range(length):
                    cy = y - (1 if k == length - 1 else 0)
                    cx = x + side * k
                    if not (0 <= cx < self.W) or (cy, cx) in self.wood or (cy, cx) in self.blocked:
                        break
                    cells.append((cy, cx, "'" if k == length - 1 else "-~"[k % 2], "j"))
                if len(cells) < 3:
                    continue
                s = Stroke("jin")
                s.cells = cells
                for cy, cx, _g, _p in cells:
                    self.wood[(cy, cx)] = s
                self.strokes.append(s)
                self.jins.append(s)
                for yy in range(y - 3, y + 4):
                    taken.setdefault(yy, set()).add(side)
                break
        if self.jins:
            self.report["jins"] = [(s.cells[0][0], len(s.cells)) for s in self.jins]

    def plan_secondaries(self, p, side):
        rng = self.rng
        secs = []
        for try_at in (0.55, 0.58, 0.61, 0.52):
            jy, jx, _t, _a = p.cells[min(len(p.cells) - 2, int(len(p.cells) * try_at))]
            length = max(3, int(round(rng.randint(6, 9) * self.scale)))
            sec = self.plan_branch("secondary", jy - 1, jx + side, side, length, "twig")
            if sec is not None:
                secs.append(sec)
                break
        if self.twigs_for() >= 2:  # a juniper's second twig, lower down: three pads fan into one
            for try_at in (0.35, 0.38, 0.32):
                jy, jx, _t, _a = p.cells[min(len(p.cells) - 2, int(len(p.cells) * try_at))]
                length = max(3, int(round(rng.randint(5, 7) * self.scale)))
                sec = self.plan_branch("secondary", jy - 1, jx + side, side, length, "twig")
                if sec is not None:
                    secs.append(sec)
                    break
        return secs

    def plan_branch(self, kind, y, x, side, length, profile, slope=None, thick=True):
        """A branch as one line, by profile: `curve` dips then rises; `chokkan` runs
        level then rises gently; `shakan` runs level after one early dip; `fallb`
        rises gently all along; `twig` rises steeply from its first cell; `wind` runs
        level lifting a row every eight cells and drops its tip; `droop` runs level then
        falls a row every three cells; `fan` climbs steeply from its first cell. Rough
        and hollow bark knuckle a branch (a jog every three to five cells, sagging after
        a dip); plated bark makes it heavy (two rows thick for most of its length)."""
        rng = self.rng
        s = Stroke(kind)
        cap_on = profile == "curve"
        knuckled = self.bark in ("rough", "hollow")
        if profile == "curve":
            s0 = -1 / rng.uniform(3.5, 4.5) if rng.random() < 0.7 else 0.0
            s1 = 1 / rng.uniform(2.0, 2.5)
        elif profile == "twig":
            s0 = s1 = 1 / rng.uniform(1.5, 2.0)
        elif profile == "fallb":
            s0 = s1 = 1 / 5.0
        elif profile == "wind":
            s0 = s1 = 1 / 8.0
        elif profile == "fan":
            s0 = s1 = slope if slope is not None else 1 / 1.4
        else:
            s0 = s1 = 0.0
        acc = 0.95 if profile == "twig" else s0 if profile == "fan" else 0.0  # a fan branch leaves at its slope
        dip_at = int(round(length * rng.uniform(0.10, 0.25))) if profile == "shakan" else -1
        next_jog = rng.randint(3, 5) if knuckled else -1
        cy, cx, last_nudge, level_run = y, x, -9, 0
        cells, dys = [], []
        for j in range(length):
            if profile == "chokkan":
                slope = 0.0 if j < 0.6 * length else 1 / 5.0
            elif profile == "shakan":
                slope = 0.0 if j < 0.6 * length else 1 / 6.0
            elif profile == "droop":
                slope = 0.0 if j < 0.6 * length else -1 / 3.0
            else:
                slope = s0 + (s1 - s0) * j / max(1, length - 1)
            if j == 0:
                dy = -1 if profile == "twig" else 0
            else:
                acc += slope
                if cap_on and j - last_nudge >= 6 and rng.random() < 0.125:
                    acc += rng.choice((-0.4, 0.4))  # a rare, gentle waver
                    last_nudge = j
                dy = 0
                if cap_on:
                    cap = 5 if abs(slope) < 0.1 else 3
                elif profile == "shakan":
                    cap = 6  # level, parallel to the ground, lifting a row every six cells
                elif profile == "wind":
                    cap = 8
                else:
                    cap = 10 ** 6
                if profile == "wind" and j == int(0.85 * length):
                    dy, acc = 1, 0.0  # the one forced step: the tip drops a row
                elif knuckled and j == next_jog:
                    dy = rng.choice((-1, 1))
                    next_jog = j + rng.randint(3, 5)
                elif j == dip_at:
                    dy = 1
                elif acc >= 1:
                    acc, dy = acc - 1, -1
                elif acc <= -1:
                    acc, dy = acc + 1, 1
                elif level_run >= cap:
                    if slope >= 0:
                        acc, dy = max(acc - 1, -0.5), -1
                    else:
                        acc, dy = min(acc + 1, 0.5), 1
                cy, cx = cy + dy, cx + side
            level_run = level_run + 1 if dy == 0 else 0
            if not (0 <= cx < self.W and self.air <= cy < self.H - 2):
                break
            if (cy, cx) in self.wood or (cy, cx) in self.blocked:
                break
            if kind == "fallb" and self.stand_span and self.stand_span[0] - 1 <= cx <= self.stand_span[1] + 1 \
                    and cy >= self.stand_top:
                break  # not across the stand
            glyph = "~" if dy == 0 else ("/" if (side > 0) == (dy < 0) else "\\")
            if knuckled and dys and dys[-1] == 1 and glyph == "~":
                glyph = "_"  # after a dip the branch sags into the jog
            cells.append((cy, cx, glyph, None))
            dys.append(dy)
        if len(cells) < (5 if kind == "fallb" else 3):
            return None
        heavy = self.bark == "plated"
        thick_share = (0.7 if heavy else 0.4) if kind == "primary" else (0.3 if heavy and kind == "secondary" else 0.0)
        if not thick:
            thick_share = 0.0
        if thick_share:  # a main branch is two rows thick for its first part
            thick = []
            own = {(cy, cx) for cy, cx, _g, _a in cells}
            for j, (cy, cx, glyph, _a) in enumerate(cells):
                thick.append((cy, cx, glyph, None))
                under = (cy + 1, cx)
                if j < thick_share * len(cells) and under[0] < self.H - 2 and under not in self.wood \
                        and under not in self.blocked and under not in own:
                    thick.append((under[0], under[1], "_" if glyph in "~_" else glyph, None))
                    own.add(under)
            cells = thick
        s.cells = cells
        for y1, x1, _t, _a in cells:
            self.wood[(y1, x1)] = s
        self.strokes.append(s)
        return s

    def plan_twin(self, trunk, R, S, w0, s, fork=(2, 5), share=(0.55, 0.70), apex=(10, 16), wshare=0.6, side=None):
        """A second trunk forking just above the soil, shorter and thinner, leaning
        away from the main trunk's first movement (the clump's trunks give their own
        fork, height share, lean, width share and side)."""
        rng, B = self.rng, self.base
        fork = rng.randint(*fork)
        y_f = B - fork
        if y_f not in self.trunk_rows:
            return None
        R2 = int(round(R * rng.uniform(*share)))
        s2 = -s if side is None else side
        apex = rng.randint(*apex)
        w2 = max(2, int(round(w0 * wshare)))
        x0, w = self.trunk_rows[y_f]
        x_edge = (x0 + w + w2 // 2) if s2 > 0 else (x0 - 1 - w2 // 2)  # beside the trunk, not in it
        points = [(0, 0), (max(2, int(0.12 * R2)), s2 * 3), (int(0.45 * R2), s2 * apex * 0.55),
                  (int(0.8 * R2), s2 * (apex - 2)), (R2, s2 * apex)]
        path = gentle_path(points, 0, R2)
        cells = [(y_f - h, x_edge + path[h]) for h in range(R2 + 1)]
        self.twin_path = {y: x for y, x in cells}
        self.twin_R, self.twin_side = R2, s2
        self.report["twin"] = f"forks {fork} rows up, R2 {R2}, apex {s2 * apex:+d} cols"
        return self.make_trunk("twin", cells, w2)

    def plan_twin_primaries(self, twin, S, R2=None, s2=None, path=None, count=2, k0=10):
        rng = self.rng
        R2 = self.twin_R if R2 is None else R2
        s2 = self.twin_side if s2 is None else s2
        path = self.twin_path if path is None else path
        L0 = S / 2 - 4
        groups = []
        for k, (h, share) in enumerate(((0.45, 0.6), (0.72, 0.45))[:count]):
            y = min(path, key=lambda yy: abs(yy - (max(path) - int(h * R2))))
            x = path[y]
            w = next((len(t) for yy, x0, t, _a in twin.cells if yy == y), 1)
            x0 = x - w // 2
            start_x = x0 + w if s2 > 0 else x0 - 1
            p = self.plan_branch("primary", y, start_x, s2, max(8, int(round(L0 * share))), "curve")
            if p is not None:
                groups.append((p, self.plan_secondaries(p, s2), k0 + k))
        return groups

    def plan_legs(self, w0):
        """The exposed-root tree's legs: three or four roots from the trunk's base row
        down to the soil, two cells wide at the top and one at the foot, splayed to
        w0 + 3 columns each side (one may cross another), the ground showing between
        them; a third of these trees clasp a rock: a boulder of shade between the legs
        up to 70 % of their height, the legs drawn over it."""
        rng, B, spec = self.rng, self.base, self.spec
        y_top = B - self.lift
        x0, w = self.trunk_rows[y_top]
        n = rng.randint(*spec["root_legs"])
        splay = w0 + 3
        if rng.random() < spec.get("rock", 0.0):
            rock_h = max(2, int(round(0.7 * self.lift)))
            s = Stroke("rock")
            for hh in range(1, rock_h + 1):
                hw = int(round(splay * 0.9 * math.sqrt(max(0.0, 1 - (hh / (rock_h + 1)) ** 2))))
                if hw < 1:
                    continue
                y, xl = B - hh, self.cx - hw
                text = "\u2592" * (2 * hw + 1)
                s.cells.append((y, xl, text, "r" * len(text)))
            if s.cells:
                y, xl, text, _p = s.cells[-1]
                cap = "".join("'."[k % 2] for k in range(len(text) - 2))
                s.cells.append((y - 1, xl + 1, cap, "r" * len(cap)))
                for y, xl, text, _p in s.cells:
                    for k in range(len(text)):
                        self.wood[(y, xl + k)] = s
                        self.ink.add((y, xl + k))
                self.strokes.append(s)
                self.legs.append(s)
                self.report["rock"] = f"{rock_h} rows"
        feet = []
        for k in range(n):
            u = (k - (n - 1) / 2) / max(0.5, (n - 1) / 2)
            top_x = x0 + int(round(k / max(1, n - 1) * (w - 1)))
            foot_x = self.cx + int(round(u * splay)) + rng.randint(-1, 1)
            if n >= 3 and rng.random() < 0.25:
                foot_x += rng.choice((-3, 3))  # one leg crosses another
            bow = (1 if u > 0 else -1 if u < 0 else 0) * rng.uniform(1.0, 2.0)  # each leg bows outward at mid-height
            points = [(0, foot_x), (self.lift * 0.5, (foot_x + top_x) / 2 + bow), (self.lift, top_x)]
            path = gentle_path(points, 0, self.lift, limit=1)
            s = Stroke("root")
            for h in range(self.lift):  # the foot first, up to the row under the trunk's base
                y, x = B - h, path[h]
                dx = path[h + 1] - x
                glyph = "|" if dx == 0 else ("/" if dx > 0 else "\\")
                wide = h > self.lift * 0.5
                text = glyph * 2 if wide else glyph
                xl = x - (1 if wide and dx <= 0 else 0)
                if h == 0:
                    text, xl = ("_" + text, xl - 1) if foot_x < self.cx else (text + "_", xl)
                s.cells.append((y, xl, text, None))
            for y, xl, text, _p in s.cells:
                for j in range(len(text)):
                    self.wood[(y, xl + j)] = s
            self.strokes.append(s)
            self.legs.append(s)
            feet.append(foot_x - self.cx)
        self.report["root legs (feet from the base)"] = feet

    def plan_back_pad(self, trunk, R, groups):
        """One pad behind the trunk at mid height, drawn never over wood, so the trunk
        and the branches show in front of it."""
        if not self.spec["back_pad"] or not groups:
            return None
        rng, B = self.rng, self.base - self.lift
        cy = B - int(round(rng.uniform(0.50, 0.56) * R))
        cx = self.trunk_x_at(cy)
        first_rx = self.pad_radii(groups[0][0])[0]
        rx = max(6, int(round(0.55 * first_rx)))
        ry = int(round(rx / 3.5)) + 1
        self.report["back pad"] = f"centre ({cy}, {cx}), rx {rx}, ry {ry}"
        return (None, rx, ry, cy, cx, (cy + 1 - ry, cy + 1, cx - rx, cx + rx))

    def pad_radii(self, p):
        """The radii of a branch's pad: about 2:1 in square units, overhanging the tip."""
        lf = self.cfg["leafiness"] * self.scale
        pads = self.spec.get("pads", "by_branch") if self.spec else "by_branch"
        if pads != "by_branch" and p.kind != "fallb":
            rx = max(3, int(round(self.rng.randint(*pads[0]) * lf)))
            ry = max(2, int(round(self.rng.randint(*pads[1]) * lf)))
        elif p.kind == "fallb":
            rx = max(3, int(round(self.rng.randint(7, 11) * lf)))
            ry = max(2, int(round(self.rng.randint(3, 4) * lf)))
        else:
            rx = max(3, int(round((0.5 * len(p.cells) + 4) * self.cfg["leafiness"])))
            ry = max(2, int(round(rx / 3.5)) + 1)
        if self.foliage == "willow" and p.kind in BRANCH_KINDS:  # the cap the strands hang from
            return max(3, int(round(0.4 * len(p.cells) + 3))), 3
        return self.style_radii(rx, ry)

    def style_radii(self, rx, ry):
        """A pad's radii in the tree's foliage style: pines always two tiers tall,
        junipers wide and flat, elms taller and rounder, tufts low."""
        style = self.foliage
        if style == "pine":
            return rx, max(4, ry)
        if style == "juniper":
            rx = int(round(rx * 1.05))
            return rx, max(2, int(round(rx / 5)) + 1)
        if style == "elm":
            return rx, int(round(rx / 2.5)) + 1
        if style == "tuft":
            return rx, min(ry, 3)
        return rx, ry

    def twigs_for(self):
        """Secondary twigs per main branch: the form's number, unless the foliage says
        otherwise (a juniper fans two pads from a branch, a willow hangs its strands)."""
        if not self.spec or not self.spec.get("twigs"):
            return 0
        return FOLIAGE[self.foliage].get("twigs", self.spec["twigs"])

    def cloud(self, twig, rx, ry, at=0.70):
        """A cloud's box and centre: over the twig at `at` of its length (a willow's cap
        near the branch's end, its box reaching down to where its strands hang)."""
        willow = self.foliage == "willow" and twig.kind in BRANCH_KINDS
        if willow:
            at = 0.85
        cy, cx = twig.cells[int(len(twig.cells) * at)][:2]
        return (twig, rx, ry, cy, cx, (cy + 1 - ry, cy + 1 + (12 if willow else 0), cx - rx, cx + rx))

    @staticmethod
    def near(a, b):
        return a[0] - 2 <= b[1] and b[0] - 2 <= a[1] and a[2] - 4 <= b[3] and b[2] - 4 <= a[3]

    def plan_clouds(self, trunk, twin, groups, back):
        """A pad per branch family, the apex pads, the back pad; air between families;
        and the drawing order: trunk, twin, back pad, families lowest first, apex last."""
        cfg, rng, B = self.cfg, self.rng, self.base
        lf = cfg["leafiness"]
        R = self.R
        families = []  # [members]; a member = (twig, rx, ry, cy, cx, box)
        for p, secs, k in groups:
            rx, ry = self.pad_radii(p)
            families.append([self.cloud(p, rx, ry)])
        boxes = [f[0][5] for f in families]
        # The twin's pads keep the air rule against the main tree's.
        if self.extra_trunks:
            main_boxes = [f[0][5] for f, (p, _s, k) in zip(families, groups) if k < 10]
            kept = []
            for f, g in zip(families, groups):
                if g[2] >= 10 and any(self.near(f[0][5], b) for b in main_boxes):
                    self.drop_branch(g[0])
                    for sec in g[1]:
                        self.drop_branch(sec)
                    continue
                kept.append((f, g))
            families, groups = [f for f, _g in kept], [g for _f, g in kept]
            boxes = [f[0][5] for f in families]
        # Apex pads: the main one at 0.90 R (the trunk ends two rows inside it); the
        # literati's is optional; the twin gets a small one.
        apexes = []
        chance = self.spec["apex_pad"]
        if chance >= 1.0 or rng.random() < chance:
            apexes.append(self.apex_pad(trunk, self.trunk_path, min(self.trunk_path), 0.90, (10, 14), (4, 5)))
        for tw, tpath, _r, _s2 in self.extra_trunks:
            a = self.apex_pad(tw, tpath, min(tpath), 0.90, (8, 10), (4, 4))
            if apexes and apexes[0] is not None and apexes[0][0] is trunk and self.near(apexes[0][5], a[5]):
                continue  # it would touch the main apex pad: that trunk ends bare
            apexes.append(a)
        for apex in apexes:
            if apex is not None:
                boxes.append(apex[5])
        self.clouds = len(boxes)
        # Secondaries whose cloud would touch another family's pad go.
        for f, (p, secs, k) in zip(families, groups):
            own = f[0][5]
            for sec in list(secs):
                c = self.cloud(sec, *self.style_radii(max(3, round(8 * lf * self.scale)), max(2, round(4 * lf * self.scale))))
                if any(b is not own and self.near(c[5], b) for b in boxes):
                    self.drop_branch(sec)
                    secs.remove(sec)
                    continue
                f.append(c)
                self.clouds += 1
        # The crown: an apex pad touching the top family's pad joins it.
        main_apex = apexes[0] if apexes and apexes[0] is not None and apexes[0][0] is trunk else None
        if main_apex is not None and families:
            top = max(range(len(families)), key=lambda i: -groups[i][0].cells[0][0] if groups[i][2] < 10 else -10 ** 6)
            if groups[top][2] < 10 and self.near(main_apex[5], families[top][0][5]):
                families[top].append(main_apex)
                apexes = [a for a in apexes if a is not main_apex]
        order = sorted(range(len(families)), key=lambda i: -groups[i][0].cells[0][0])  # lowest first
        pads = {i: self.fill_pad(families[i]) for i in order}
        self.report["pads (centre, rx, ry)"] = [(f[0][3], f[0][4], f[0][1], f[0][2]) for f in families]
        back_pad = self.fill_pad([back], never_over_wood=True) if back is not None else None
        apex_pads = [self.fill_pad([a]) for a in apexes if a is not None]
        chain = [trunk] + self.legs + self.jins + [t for t, _p, _r, _s2 in self.extra_trunks] \
            + ([back_pad] if back_pad is not None else [])
        for i in order:
            p, secs, _k = groups[i]
            chain.extend([p] + secs + [pads[i]])
        chain.extend(apex_pads)
        for a, b in zip(chain, chain[1:]):
            a.after.append(b)

    def apex_pad(self, trunk, path, top_y, share, rx_range, ry_range):
        """A low, wide dome over the top of a trunk, its base at `share` of the
        trunk's height; the trunk ends two rows inside it."""
        rng, lf = self.rng, self.cfg["leafiness"] * self.scale
        bottom = max(path)
        R = bottom - top_y
        apex_y = bottom - int(round(share * R))
        apex_x = (path.get(apex_y - 1, path[top_y]) + path[top_y]) // 2
        rx = max(3, int(round(rng.randint(*rx_range) * lf)))
        ry = max(2, int(round(rng.randint(*ry_range) * lf)))
        if self.topjin and trunk.kind == "trunk":
            apex_y = max(apex_y, top_y + 3 + ry)  # the top jin stands clear above the pad
            apex_x = path.get(apex_y, path[top_y])
        else:
            for y1, x1, text, _a in trunk.cells:
                if y1 < apex_y - ry + 2:
                    for k in range(len(text)):
                        self.wood.pop((y1, x1 + k), None)
            trunk.cells = [c for c in trunk.cells if c[0] >= apex_y - ry + 2]
        return (trunk, rx, ry, apex_y - 1, apex_x, (apex_y - ry, apex_y, apex_x - rx, apex_x + rx))

    def drop_branch(self, s):
        if s in self.strokes:
            self.strokes.remove(s)
        for y1, x1, _t, _a in s.cells:
            if self.wood.get((y1, x1)) is s:
                del self.wood[(y1, x1)]

    def fill_pad(self, members, never_over_wood=False, edge_at=None):
        """One mass of leaves over a family's twigs, in the tree's foliage style: the
        union of a flat-bottomed dome per twig, each cell by its nearest dome, full inside
        and feathering out at the edge, lit along the top of the ideal dome (a pine in
        tiers with a dark seam under each, a tuft lit on its top row only), holes where
        the style has them, blooms or fruit as accents, a willow's strands hanging from
        its branch; it grows from the branch's end outward and over the wood beneath it."""
        cfg, rng = self.cfg, self.rng
        style = "cloud" if never_over_wood else self.foliage
        spec = FOLIAGE[style]
        edge_at = spec["edge_at"] if edge_at is None else edge_at
        twigs = {m[0] for m in members if m[0] is not None}
        boxes = [m[5] for m in members]
        cover = set() if never_over_wood else {
            cell for cell, owner in self.wood.items() if owner in twigs
            and any(y0 <= cell[0] <= y1 and x0 <= cell[1] <= x1 for y0, y1, x0, x1 in boxes)}
        twig0 = members[0][0]
        if twig0 is None or twig0.kind in TRUNK_KINDS:
            o_y, o_x = members[0][3], members[0][4]
        else:
            o_y, o_x = twig0.cells[-1][:2]
        bottom = max(m[3] for m in members) + 1  # the pads' lowest row

        def inside(y, x):  # within a dome's full part (not its feathered edge)
            return any(cy + 1 - ry <= y <= cy + 1 and math.hypot((x - cx) / rx, (cy + 1 - y) / ry) <= edge_at
                       for _t, rx, ry, cy, cx, _b in members)
        chosen = {}  # (y, x) -> (edge?, tone, y_top, h); tone L lit, l shaded, u underside or seam, e edge
        for y in range(min(b[0] for b in boxes), min(bottom, max(b[1] for b in boxes)) + 1):
            for x in range(min(b[2] for b in boxes), max(b[3] for b in boxes) + 1):
                if not (0 <= y <= self.H - 3 and 0 <= x < self.W) or (y, x) in self.blocked:
                    continue
                best = None
                for _t, rx, ry, cy, cx, _b in members:
                    if cy + 1 - ry <= y <= cy + 1:
                        d = math.hypot((x - cx) / rx, (cy + 1 - y) / ry)
                        if best is None or d < best[0]:
                            best = (d, rx, ry, cy, cx)
                if best is None or best[0] > 1:
                    continue
                d, rx, ry, cy, cx = best
                if (y, x) in self.wood:
                    if (y, x) not in cover:
                        continue  # wood in front of this pad stays
                elif rng.random() > (1.0 if d < edge_at else (1 - d) / (1 - edge_at)):
                    continue  # covered wood always gets its leaf; the rest feathers out
                edge = d > edge_at
                if not edge and spec["hole"] and (y, x) not in self.wood and rng.random() < spec["hole"]:
                    continue  # light through the fine twigs
                dxn = (x - cx) / rx
                y_top = cy + 1 - ry * math.sqrt(max(0.0, 1 - dxn * dxn))
                h = cy + 1 - y_top
                if edge:
                    tone = "e"
                elif spec["lit"] == "tiers":  # the pine: strata, a dark seam under each tier
                    r = bottom - y
                    tone = "L" if not inside(y - 1, x) else ("u", "l", "L")[r % 3]
                elif spec["lit"] == "top":
                    tone = "L" if y < y_top + 1.0 else "l"
                else:
                    tone = "L" if y < y_top + spec["lit"] * h else "l"
                if spec["under"] and y == bottom and not edge:
                    tone = "u"
                chosen[(y, x)] = (edge, tone, y_top, h)
        by_row = {}
        for y, x in chosen:
            by_row.setdefault(y, []).append(x)
        for y, xs in by_row.items():  # no specks floating above the mass
            if len(xs) < 4 and not any((y, x) in cover for x in xs):
                for x in xs:
                    del chosen[(y, x)]
        spots, plain = [], []
        accents = spec.get("accent", ())
        blooms = 0
        for (y, x), (edge, tone, y_top, h) in chosen.items():
            char = rng.choice(self.leaf_edge if edge else self.leaf_set)
            if tone == "u" and spec.get("seam") and y != bottom:
                char = rng.choice(spec["seam"])
            attr = {"e": self.attrs["leaf"][0], "l": self.attrs["leaf"][0], "L": self.attrs["leaf"][1],
                    "u": self.attrs["leaf_under"]}[tone]
            kind = None
            if accents and tone in ("L", "l"):
                for a_char, what, share in accents:
                    in_zone = (y < y_top + 0.6 * h) if what in ("bloom", "rosebud") else (y >= y_top + 0.4 * h)
                    if in_zone and rng.random() < share:
                        char, attr, kind = a_char, self.attrs[what], what
                        blooms += what == "bloom"
                        break
                if kind is None:
                    plain.append(len(spots))
            order = math.hypot((x - o_x) / 2, y - o_y) + rng.uniform(0, 0.5)
            spots.append((order, y, x, char, attr, kind))
        if accents and accents[0][1] == "bloom" and blooms < 3 and plain:  # at least three blooms a pad
            for i in rng.sample(plain, min(len(plain), 3 - blooms)):
                o, y, x, _c, _a, _k = spots[i]
                spots[i] = (o, y, x, "@", self.attrs["bloom"], "bloom")
        spots.sort()
        s = Stroke("leaf")
        s.cells = [(y, x, char, attr) for _o, y, x, char, attr, _k in spots]
        for _o, y, x, _c, _a, kind in spots:
            if kind:
                self.accents[(y, x)] = kind
        s.cover = cover
        if style == "willow" and twig0 is not None and twig0.kind in BRANCH_KINDS:
            self.willow_strands(s, twig0, chosen)
        self.strokes.append(s)
        return s

    def willow_strands(self, s, branch, chosen):
        """A willow's curtains: from every second cell of the branch from a quarter of
        its length a strand of 3 + 7t cells hangs, its first two cells lit, its last a
        comma; under the cap a strand begins below it; it stops at wood, at the planter
        and two rows above the soil."""
        rng, spec = self.rng, FOLIAGE["willow"]
        cells = branch.cells
        n = len(cells)
        strand = []
        taken = set()
        for j, (y, x, _g, _p) in enumerate(cells):
            t = j / max(1, n - 1)
            if t < 0.25 or j % 2:
                continue
            length = int(round(3 + 5 * t)) + rng.randint(0, 2)
            k, yy = 0, y + 1
            while k < length and yy < self.base - 1:
                cell = (yy, x)
                yy += 1
                if cell in chosen and not chosen[cell][0]:
                    continue  # under the cap: the strand begins below it
                if cell in self.wood or cell in self.blocked or cell in chosen or cell in taken:
                    break
                if k < 2:
                    char, attr = "|", self.attrs["leaf"][1]
                elif k == length - 1:
                    char, attr = rng.choice(",'"), self.attrs["leaf"][0]
                else:
                    char, attr = rng.choice(spec["strand"]), self.attrs["leaf"][0]
                strand.append((cell[0], cell[1], char, attr))
                taken.add(cell)
                k += 1
        s.cells.extend(strand)  # the curtains hang after the cap, top down

    # ---- the cascade ---------------------------------------------------------------------

    def plan_kengai(self, shrink):
        """The cascade: a short rising trunk with a crown, then the trunk arcs over the
        rim and falls beside the tall stand, branches with hanging pads alternating down
        it; the hexagon pot on the cascade stand."""
        cfg, rng, B = self.cfg, self.rng, self.base
        s = self.first_side  # the fall side
        self.scale = min(1.0, (self.H - 30) / 90.0)  # the cascade's proportions, by the screen's height
        rise = max(5, int(round(rng.randint(8, 12) * self.scale)))
        fall_len = int(round(rng.randint(36, 42) * self.scale))
        fall_len = max(12, min(fall_len, self.H - 6 - B))
        total_len = rise + 2 + fall_len
        self.R, self.S, self.w0 = rise, 0, 5
        # The crown's size is drawn first: it sets the pot's width, and the pot's rim
        # is where the rise climbs out to.
        crown_rx = max(4, int(round(rng.randint(9, 11) * self.scale)))
        crown_ry = max(2, int(round(rng.randint(3, 4) * self.scale)))
        self.crown_spread = 2 * crown_rx + 14
        if self.planter:
            width = self.planter[2]
        else:
            width = max(LEAST_POT.get("hexagon", 25), min(self.W - 4, int(1.2 * self.crown_spread))) | 1
        to_rim = int(round(0.35 * width)) + 1  # the base stands 35 % in from the fall side's edge
        # One line: the rise climbs out over the rim (about 1.3 columns a row), and the
        # fall continues from its top.
        points = [(0, 0), (int(rise * 0.5), s * (to_rim + 1) * 0.4), (rise, s * (to_rim + 1))]
        path = gentle_path(points, 0, rise, limit=2)
        cells = [(B - h, self.cx + path[h]) for h in range(rise + 1)]
        self.trunk_path = {y: x for y, x in cells}
        trunk = self.make_trunk("trunk", cells, 5, ("_/", "\\_"), 0, total_len)
        apex_y, x_top = cells[-1]
        # A short branch on the inner side at 60 % of the rise carries the crown pad.
        by = B - int(round(rise * 0.6))
        x0, w = self.trunk_rows[by]
        short = self.plan_branch("primary", by, x0 - 1 if s > 0 else x0 + w, -s,
                                 max(4, int(round(rng.randint(8, 10) * self.scale))), "curve")
        self.report.update({"rise": rise, "fall": fall_len, "crown": f"rx {crown_rx} ry {crown_ry}"})
        self.layout_pot()
        rim = self.pot_rows[0][0] + (self.pot_width - 1 if s > 0 else 0)
        x_start = rim + s * 2  # the fall passes two columns outside the rim
        # The fall: out a little from the top, down past the rim, then two gentle
        # movements, never more than a column a row, within ten columns of the rim.
        m1, m2 = rng.randint(6, 8), rng.randint(6, 10)
        d_end = min(8, rng.randint(8, 16))
        fpoints = [(apex_y, x_top), (apex_y + 2, x_top + 2 * s), (B - 2, x_start),
                   (B + int(fall_len * 0.35), x_start + s * m1),
                   (B + int(fall_len * 0.7), x_start + s * max(0, m1 - m2)),
                   (B + fall_len, x_start + s * d_end)]
        fpath = gentle_path(fpoints, apex_y + 1, B + fall_len, limit=1)
        fcells = [(y, fpath[y]) for y in range(apex_y + 1, B + fall_len + 1)]
        fall = self.make_trunk("fall", fcells, 3, None, rise + 1, total_len)
        # The crown pad over the inner branch, and a small cap on the arc's top.
        cap_rx, cap_ry = max(3, int(round(rng.randint(6, 8) * self.scale))), max(2, int(round(3 * self.scale)))
        cap_box = (apex_y - cap_ry, apex_y, x_top - cap_rx, x_top + cap_rx)
        crown_members = ([self.cloud(short, crown_rx, crown_ry)] if short is not None else [])
        cap_members = [(trunk, cap_rx, cap_ry, apex_y - 1, x_top, cap_box),
                       (fall, cap_rx, cap_ry, apex_y - 1, x_top, cap_box)]
        # Branches down the fall, alternating sides, each with a hanging pad.
        fgroups = []
        y = B + rng.randint(5, 7)
        side = s
        k = 0
        while y <= B + fall_len - 4:
            x = fpath[y]
            xw = next((len(t) for yy, x0, t, _a in fall.cells if yy == y), 1)
            x0 = x - xw // 2
            start_x = x0 + xw if side > 0 else x0 - 1
            length = max(5, int(round(rng.randint(10, 16) * self.scale)))
            br = self.plan_branch("fallb", y, start_x, side, length, "fallb")
            if br is not None:
                fgroups.append((br, [], k))
                k += 1
            side = -side
            y += max(4, int(round(rng.randint(8, 11) * self.scale)))
        self.report["fall branches (row, length)"] = [(g[0].cells[0][0], len(g[0].cells)) for g in fgroups]
        self.report["fall x from the rim"] = f"{min(fpath[y] - rim for y in fpath if y >= B) * s} to " \
                                             f"{max(fpath[y] - rim for y in fpath if y >= B) * s} cols"
        # Pads: the crown and the cap first, then the hanging ones, kept apart.
        crown_pad = self.fill_pad(crown_members) if crown_members else None
        cap_pad = self.fill_pad(cap_members)
        boxes = [c[5] for c in crown_members] + [cap_box]
        fams = []
        for br, _secs, _k in fgroups:
            rx, ry = self.pad_radii(br)
            c = self.cloud(br, rx, ry)
            if any(self.near(c[5], b) for b in boxes):
                self.drop_branch(br)
                continue
            boxes.append(c[5])
            fams.append((br, c))
        self.clouds = len(boxes)
        pads = [(br, self.fill_pad([c])) for br, c in fams]
        self.report["pads (centre, rx, ry)"] = [(c[3], c[4], c[1], c[2]) for _br, c in fams]
        chain = [trunk] + ([short, crown_pad] if crown_pad is not None else []) + [fall, cap_pad]
        for br, pad in pads:
            chain.extend([br, pad])
        for a, b in zip(chain, chain[1:]):
            a.after.append(b)

    def steep_line(self, kind, y0, x0, rows, reach, bow=0.0):
        """A fine branch climbing `rows` rows and reaching `reach` columns, one cell a
        row (| / \\), stopping at wood, the planter or the screen's edge."""
        points = [(0, 0), (rows * 0.5, reach * 0.45 + bow), (rows, reach)]
        path = gentle_path(points, 0, rows, limit=1)
        s = Stroke(kind)
        for h in range(rows + 1):
            y, x = y0 - h, x0 + path[h]
            if not (self.air <= y < self.H - 2 and 0 <= x < self.W) or (y, x) in self.wood or (y, x) in self.blocked:
                break
            dx = path.get(h + 1, path[h]) - path[h]
            s.cells.append((y, x, "|" if dx == 0 else ("/" if dx > 0 else "\\"), None))
        if len(s.cells) < 3:
            return None
        for y, x, _g, _p in s.cells:
            self.wood[(y, x)] = s
        self.strokes.append(s)
        return s

    def fan_branch(self, kind, y, x, side, rows, reach):
        """One branch of a fan: steep ones a cell a row, shallow ones a cell a column."""
        if reach <= rows:
            return self.steep_line(kind, y, x, rows, side * reach, self.rng.uniform(-1, 1))
        return self.plan_branch(kind, y, x, side, reach, "fan", slope=rows / reach, thick=False)

    def plan_hokidachi(self, R, S, w0):
        """The broom (hokidachi): a short straight trunk ending at a third of the
        height, five to seven fine branches fanning from its top row, the middle ones
        near vertical and the outer ones shallow, each forking twice; one rounded crown
        over the upper fan, the lower fan bare beneath it."""
        rng, B, spec = self.rng, self.base, self.spec
        top = max(4, int(round(rng_range(rng, spec["trunk_top"]) * R)))
        cells = [(B - h, self.cx) for h in range(top + 1)]
        self.trunk_path = {y: x for y, x in cells}
        trunk = self.make_trunk("trunk", cells, w0, spec["roots"], 0, R + 1)
        y_t = B - top
        x0, w = self.trunk_rows[y_t]
        n = rng.randint(*spec["branches"])
        fan_rows = max(6, int(round(rng_range(rng, spec["fan_height"]) * (R - top))))
        reach_max = max(6, int(round(S / 2 - 2)))
        fan, twigs = [], {}
        for k in sorted(range(n), key=lambda k: abs(k - (n - 1) / 2)):  # the centre first
            u = (k - (n - 1) / 2) / max(0.5, (n - 1) / 2)
            side = 1 if u > 0 else -1 if u < 0 else rng.choice((-1, 1))
            sx = x0 + int(round(k / max(1, n - 1) * (w - 1)))
            rows = max(4, int(round(fan_rows * (1 - 0.3 * abs(u)) * rng.uniform(0.9, 1.0))))
            reach = int(round(abs(u) * reach_max * rng.uniform(0.85, 1.0))) + (1 if u == 0 and rng.random() < 0.5 else 0)
            br = self.fan_branch("primary", y_t - 1, sx, side, rows, reach)
            if br is None:
                continue
            fan.append(br)
            twigs[br] = []
            for share in (0.45, 0.70):
                jy, jx = br.cells[min(len(br.cells) - 1, int(share * len(br.cells)))][:2]
                t_rows = max(3, int(round(rows * 0.3)))
                t_reach = max(2, int(round(t_rows * (0.6 + 0.8 * abs(u)))))
                t_side = side if u != 0 else (-1 if share < 0.5 else 1)
                tw = self.fan_branch("secondary", jy - 1, jx + t_side, t_side, t_rows, t_reach)
                if tw is not None:
                    twigs[br].append(tw)
        cx = x0 + w // 2
        cy = y_t - int(round(0.65 * fan_rows))
        rx, ry = reach_max, max(3, int(round(0.45 * (R - top))))
        box = (cy + 1 - ry, cy + 1, cx - rx, cx + rx)
        members = [(br, rx, ry, cy, cx, box) for br in fan] + [(tw, rx, ry, cy, cx, box) for br in fan for tw in twigs[br]]
        crown = self.fill_pad(members, edge_at=0.72) if members else None
        self.clouds = 1 if crown else 0
        self.report.update({"R": R, "S": S, "w0": w0, "trunk top": top, "fan": f"{len(fan)} branches, {fan_rows} rows",
                            "crown": f"centre ({cy}, {cx}), rx {rx}, ry {ry}"})
        chain = [trunk] + self.jins
        for br in fan:
            chain.extend([br] + twigs[br])
        if crown is not None:
            chain.append(crown)
        for a, b in zip(chain, chain[1:]):
            a.after.append(b)

    def plan_hankengai(self, shrink):
        """The semi-cascade (hankengai): the cascade's short rise and crown and the
        arc over the rim, then a run out past the rim easing down but never below
        the planter's body, three rows thick at first and one at the tip, with two
        or three branches rising from the run and their pads above it."""
        cfg, rng, B = self.cfg, self.rng, self.base
        spec, s = self.spec, self.first_side
        self.scale = min(1.0, (self.H - 30) / 90.0)
        rise = max(5, int(round(rng_range(rng, spec["rise"]) * self.scale)))
        out = max(10, int(round(rng_range(rng, spec["out"]) * self.scale * shrink)))
        self.R, self.S, self.w0 = rise, 0, spec["trunk_width"]
        crown_rx = max(4, int(round(rng.randint(*spec["crown"][0]) * self.scale)))
        crown_ry = max(2, int(round(rng.randint(*spec["crown"][1]) * self.scale)))
        self.crown_spread = 2 * crown_rx + 14
        self.layout_pot()
        width = self.pot_width
        rim_x = self.pot_rows[0][0] + (width - 1 if s > 0 else 0)
        to_rim = abs(rim_x - self.cx)
        total_len = rise + 2 + out
        points = [(0, 0), (int(rise * 0.5), s * (to_rim + 1) * 0.4), (rise, s * (to_rim + 1))]
        path = gentle_path(points, 0, rise, limit=2)
        cells = [(B - h, self.cx + path[h]) for h in range(rise + 1)]
        self.trunk_path = {y: x for y, x in cells}
        trunk = self.make_trunk("trunk", cells, spec["trunk_width"], ("_/", "\\_"), 0, total_len)
        apex_y, x_top = cells[-1]
        by = B - int(round(rise * 0.6))
        x0, w = self.trunk_rows[by]
        short = self.plan_branch("primary", by, x0 - 1 if s > 0 else x0 + w, -s,
                                 max(4, int(round(rng.randint(8, 10) * self.scale))), "curve")
        # The arc: out from the top and down to the rim's row, two columns outside it.
        x_start = rim_x + s * 2
        y_rim = B - 1
        apoints = [(apex_y, x_top), (apex_y + 2, x_top + 2 * s), (y_rim - 1, x_start - s), (y_rim, x_start)]
        apath = gentle_path(apoints, apex_y + 1, y_rim, limit=2)
        acells = [(y, apath[y]) for y in range(apex_y + 1, y_rim + 1)]
        arc = self.make_trunk("fall", acells, 3, None, rise + 1, total_len)
        # The run: a cell a column out past the rim, easing down within the body's rows.
        body_rows = sum(1 for _x, _t, _p, st in self.pot_rows if not st)
        drop = rng_range(rng, spec["drop"]) * self.scale * min(1.0, out / 26.0)  # a run cut short drops less
        drop = max(1, min(int(round(drop)), body_rows - 2))
        run = Stroke("fall")
        prev_y, run_top = y_rim, {}
        for j in range(1, out + 1):
            x = x_start + s * j
            y = y_rim + int(round(drop * (j / out) ** 1.8))
            if not (0 <= x < self.W) or y > y_rim + body_rows - 1:
                break
            thick = next((rows for rows, until in spec["thick"] if j < until * out), 1)
            top = ("\\" if s > 0 else "/") if y > prev_y else "~"
            column = [(y, x, top, None)]
            if thick == 3:
                column += [(y + 1, x, "|", "k"), (y + 2, x, "_", None)]
            elif thick == 2:
                column.append((y + 1, x, "_", None))
            for cy, cx, g, p in column:
                if cy > y_rim + body_rows - 1 or (cy, cx) in self.blocked or (cy, cx) in self.wood:
                    continue
                run.cells.append((cy, cx, g, p))
                self.wood[(cy, cx)] = run
                if p == "k":
                    self.ink.add((cy, cx))
            run_top[j] = (y, x)
            prev_y = y
        self.strokes.append(run)
        self.report.update({"rise": rise, "out": len(run_top), "drop": drop, "crown": f"rx {crown_rx} ry {crown_ry}"})
        # The crown over the inner branch and the cap on the arc's top, as the cascade's.
        cap_rx, cap_ry = max(3, int(round(rng.randint(6, 8) * self.scale))), max(2, int(round(3 * self.scale)))
        cap_box = (apex_y - cap_ry, apex_y, x_top - cap_rx, x_top + cap_rx)
        crown_members = ([self.cloud(short, crown_rx, crown_ry)] if short is not None else [])
        cap_members = [(trunk, cap_rx, cap_ry, apex_y - 1, x_top, cap_box),
                       (arc, cap_rx, cap_ry, apex_y - 1, x_top, cap_box)]
        # Branches rising from the run at 40 %, 75 % and the tip, their pads above it.
        n_b = rng.randint(*spec["fall_branches"])
        shares = (0.40, 0.75, 0.97)[:n_b]
        lf = cfg["leafiness"] * self.scale
        fgroups = []
        for k, share in enumerate(shares):
            j = max(1, min(len(run_top), int(round(share * len(run_top)))))
            if j not in run_top:
                continue
            y, x = run_top[j]
            length = max(5, int(round(rng.randint(8, 12) * self.scale)))
            br = self.plan_branch("fallb", y - 1, x + s, s, length, "fallb", thick=False)
            if br is not None:
                fgroups.append((br, [], k))
        crown_pad = self.fill_pad(crown_members) if crown_members else None
        cap_pad = self.fill_pad(cap_members)
        boxes = [c[5] for c in crown_members] + [cap_box]
        fams = []
        for br, _secs, _k in fgroups:
            rx = max(3, int(round(rng.randint(*spec["fall_pads"][0]) * lf)))
            ry = max(2, int(round(rng.randint(*spec["fall_pads"][1]) * lf)))
            c = self.cloud(br, rx, ry)
            if any(self.near(c[5], b) for b in boxes):
                self.drop_branch(br)
                continue
            boxes.append(c[5])
            fams.append((br, c))
        self.clouds = len(boxes)
        pads = [(br, self.fill_pad([c])) for br, c in fams]
        self.report["run branches (column, length)"] = [(g[0].cells[0][1], len(g[0].cells)) for g in fgroups]
        self.report["pads (centre, rx, ry)"] = [(c[3], c[4], c[1], c[2]) for _br, c in fams]
        chain = [trunk] + self.jins + ([short, crown_pad] if crown_pad is not None else []) + [arc, run, cap_pad]
        for br, pad in pads:
            chain.extend([br, pad])
        for a, b in zip(chain, chain[1:]):
            a.after.append(b)

    # ---- the planter and the composition -------------------------------------------------

    def spread(self):
        """How many columns the finished tree covers."""
        xs = [x + k for s in self.strokes for y, x, text, _a in s.cells for k in range(len(text))]
        return max(xs) - min(xs) + 1 if xs else 20

    def planting_offset(self, width):
        """How far from the pot's left column the base stands, so it sits off-centre
        in the pot as the form asks."""
        s = self.first_side
        if self.style in CASCADES:
            frac, from_left = 0.35, s < 0  # 35 % from the fall side's edge
            if self.style == "hankengai":  # in the run's wide tray: a dozen columns from the rim
                frac = min(0.35, 12.0 / max(1, width))
        else:
            frac, rule = self.spec["planting"]
            if isinstance(frac, (tuple, list)):  # a range: spread over the trees by their height
                frac = frac[0] + (frac[1] - frac[0]) * ((self.report.get("R", 7) % 7) / 6)
            from_left = {"left": True, "away_from_lean": s > 0, "opposite_first_branch": s > 0,
                         "opposite_apex": self.report.get("apex offset", 0) >= 0}[rule]
        if self.twin and self.style != "kengai":
            frac, from_left = 0.45, self.twin_side > 0  # from the side away from the twin
        offset = frac * width if from_left else (1 - frac) * width
        self.report["planting"] = f"base {frac:.2f} of the pot's width from its {'left' if from_left else 'right'} edge"
        return int(round(offset))

    def planting(self, width):
        """The pot's left column relative to the base column."""
        return self.cx - self.planting_offset(width)

    def layout_pot(self):
        """Sizes the planter to the canopy and places it and its stand under the base,
        off-centre as the form asks; draws nothing yet."""
        if self.pot_kind == "no":
            return
        least = LEAST_POT.get(self.pot_kind, 25)
        room = self.W - 2 * self.margin
        if self.planter:  # the planter already standing there
            _k, _s, width, x0, stand_w, sx0 = self.planter
        elif self.pot_kind in USER_POTS:  # a user's planter is as wide as drawn
            width = len(USER_POTS[self.pot_kind][0][0][0])
        elif self.style == "kengai":
            width = max(least, min(room, int(1.2 * self.crown_spread))) | 1
        elif self.style == "hankengai":  # the run's wide planter, sized to the crown when named
            width = int(1.2 * self.crown_spread)
            if self.cfg["pot"] == "auto":
                width = max(width, int(0.6 * self.W))
            width = max(least, min(room, width)) | 1
        else:
            share = POTS[self.pot_kind][1]
            width = int(share * self.spread())
            if self.cfg["pot"] == "auto":  # the run's planter: really wide, whatever grows first
                width = max(width, int(0.6 * self.W))
            width = max(least, min(room, width)) | 1
        rows = pot_rows_for(self.pot_kind, width)
        if self.stand_kind and has_shadow(rows):
            rows = rows[:-1]
        if self.stand_kind and not self.planter:
            # A display stand is wider than its pot; the cascade's is slender, so the
            # pot overhangs it and the fall drops clear of its leg.
            factor = {"stand": 1.25, "tall": 1.5, "cascade": 0.8}[self.stand_kind]
            stand_w = max(21, min(room, int(width * factor))) | 1
        elif not self.stand_kind:
            stand_w = 0
        self.pot_width = width
        if not self.planter:
            x0 = self.planting(width)
        block = [(x0, text, paint, False) for text, paint in rows]
        if self.stand_kind:
            if not self.planter:
                sx0 = x0 + width // 2 - stand_w // 2
            srows = stand_rows(stand_w, self.stand_kind)
            self.stand_top = self.H - len(srows)
            self.stand_span = (sx0 + 1, sx0 + stand_w - 2)
            block += [(sx0, text, paint, True) for text, paint in srows]
        self.pot_rows = block
        soil_text, soil_paint = rows[1]
        gravel = [k for k, p in enumerate(soil_paint) if p in "gm"]
        self.rim = (x0 + gravel[0], x0 + gravel[-1]) if gravel else None
        # The columns the planter's rim and soil rows occupy: a leaf over them lands on
        # the planter; beside them, under a curved shoulder, it falls to the table.
        self.pot_cols = {x0 + k for text, paint in rows[:2] for k, p in enumerate(paint) if p != " "}
        self.pot_spec = (self.pot_kind, width, self.stand_kind, stand_w)
        y_top = self.H - len(block)
        # Nothing of the tree is drawn inside the planter's or the stand's outline.
        self.blocked = {(y_top + i, bx0 + k) for i, (bx0, text, paint, _st) in enumerate(block)
                        for k in range(len(text)) if i > 0}

    def composition_box(self):
        xs = [x + k for s in self.strokes for y, x, text, _a in s.cells for k in range(len(text))]
        for x0, text, paint, _st in self.pot_rows:
            xs += [x0 + k for k, p in enumerate(paint) if p != " "]
        if self.style in CASCADES:  # the hanging pads are planned after the planter
            xs += [x0 + k for x0, text, paint, _st in self.pot_rows for k in range(len(text))]
        return (min(xs), max(xs)) if xs else (self.cx, self.cx)

    def translate(self, dx):
        """Moves the tree `dx` columns, and the planter with it unless the planter is
        the one already standing on the screen."""
        if dx == 0:
            return
        for s in self.strokes:
            s.cells = [(y, x + dx, text, attr) for y, x, text, attr in s.cells]
            s.cover = {(y, x + dx) for y, x in s.cover}
        self.wood = {(y, x + dx): s for (y, x), s in self.wood.items()}
        self.ink = {(y, x + dx) for y, x in self.ink}
        self.trunk_rows = {y: (x0 + dx, w) for y, (x0, w) in self.trunk_rows.items()}
        self.trunk_path = {y: x + dx for y, x in self.trunk_path.items()}
        if hasattr(self, "twin_path"):
            self.twin_path = {y: x + dx for y, x in self.twin_path.items()}
        self.extra_trunks = [(t, {y: x + dx for y, x in p.items()}, r, s2) for t, p, r, s2 in self.extra_trunks]
        self.cx += dx
        if self.planter:
            return
        self.pot_rows = [(x0 + dx, text, paint, st) for x0, text, paint, st in self.pot_rows]
        self.blocked = {(y, x + dx) for y, x in self.blocked}
        self.pot_cols = {x + dx for x in self.pot_cols}
        if self.rim:
            self.rim = (self.rim[0] + dx, self.rim[1] + dx)
        if self.stand_span:
            self.stand_span = (self.stand_span[0] + dx, self.stand_span[1] + dx)

    def draw_pot(self, top_only=False):
        """Draws the planter and its stand from their rows and paint; `top_only`
        redraws just the far rim and the soil, where a crumbled trunk stood."""
        cfg, color = self.cfg, self.attrs["color"]
        if not self.pot_rows:
            return
        body_name, trim_name = pot_palette(self.pot_kind)
        if PALETTE_WAY:  # over a landscape the blue and cyan slots are the dimmed sky: a grey glaze
            body_name, trim_name = ("white" if n in ("blue", "cyan", "magenta") else n for n in (body_name, trim_name))
        body = color[cfg["pot_color"] if cfg["pot_color"] != "auto" else body_name]
        trim = color[cfg["trim_color"] if cfg["trim_color"] != "auto" else trim_name]
        stand = self.attrs["stand"]
        paints = {"b": body, "B": body | curses.A_BOLD, "t": trim, "T": trim | curses.A_BOLD,
                  "g": self.attrs["gravel"], "m": self.attrs["moss"], "s": self.attrs["shadow"]}
        y_top = self.H - len(self.pot_rows)
        for i, (x0, text, paint, on_stand) in enumerate(self.pot_rows):
            if top_only and i > 1:
                break
            y = y_top + i
            if self.backdrop and not top_only:  # the planter's body sits on black
                inked = [k for k, p in enumerate(paint) if p != " "]
                if inked:
                    self.backdrop.clear(y, x0 + inked[0], x0 + inked[-1])
                    self.put(y, x0 + inked[0], " " * (inked[-1] - inked[0] + 1), 0)
            for k, (ch, p) in enumerate(zip(text, paint)):
                if p == " ":
                    continue
                attr = paints[p]
                if on_stand and p in "bBtT":
                    attr = stand | (curses.A_BOLD if p in "BT" else 0)
                if top_only and (y, x0 + k) in self.grid:
                    continue  # only where the crumbled trunk stood; the carpet stays
                self.put(y, x0 + k, ch, attr)
                self.grid[(y, x0 + k)] = ("soil" if p in "gm" else "pot", ch, attr)

    # ---- drawing -----------------------------------------------------------------------

    def put(self, y, x, text, attr):
        """Writes `text` at (y, x) in `attr`; over a landscape, each cell on the
        landscape's own background there."""
        if not (0 <= y < self.H and 0 <= x < self.W):
            return
        text = text[: self.W - x]
        if self.backdrop is None:
            self.put_raw(y, x, text, attr)
            return
        row = self.backdrop.bg[y]
        bg = [0 if (y, x + k) in self.ink else row[x + k] for k in range(len(text))]
        i = 0
        while i < len(text):
            k = i + 1
            while k < len(text) and bg[k] == bg[i]:
                k += 1
            self.put_raw(y, x + i, text[i:k], PAIRS.on(attr, bg[i]))
            i = k

    def halo_add(self, cell):
        self.halo_shift(cell, 1)

    def halo_drop(self, cell):
        self.halo_shift(cell, -1)

    def halo_shift(self, cell, d):
        """A tree cell came (+1) or went (-1): its eight neighbours gain or lose a count
        of the halo, the margin of paper the landscape keeps around the ink."""
        if not self.backdrop:
            return
        y0, x0 = cell
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                n = (y0 + dy, x0 + dx)
                if (dy or dx) and 0 <= n[0] < self.H and 0 <= n[1] < self.W and self.backdrop.halo_shift(n, d):
                    if n not in self.grid and n not in self.busy:
                        self.restore(n)

    def put_raw(self, y, x, text, attr):
        try:
            self.scr.addstr(y, x, text, attr)
        except curses.error:
            pass  # the bottom-right cell refuses a write; nothing is lost

    def delay(self, s):
        """Seconds before stroke `s` draws its next cell."""
        cfg = self.cfg
        if s.kind == "leaf":
            return cfg["step"]
        if s.kind == "fall":
            return cfg["step"] * 2.5
        if s.kind in TRUNK_KINDS:
            return cfg["step"] * cfg["aspect"] * 1.5
        before, after = s.cells[s.pos - 1], s.cells[s.pos]
        factor = cfg["aspect"] if after[0] != before[0] else 1.0
        return cfg["step"] * factor * (0.8 + cfg["ease"] * s.pos / len(s.cells))

    def growth_units(self):
        """How long the tree takes to grow, in units of `step`: the pen draws one
        stroke after another, each after its gap, each cell after its delay."""
        kept = self.cfg
        self.cfg = dict(kept, step=1.0)
        units = 0.0
        queue = collections.deque([self.strokes[0]])
        while queue:
            s = queue.popleft()
            units += kept["gap"]
            for i in range(1, len(s.cells)):
                s.pos = i
                units += self.delay(s)
            s.pos = 0
            queue.extend(s.after)
        self.cfg = kept
        return units

    def pace(self, cycle, t_start):
        """Sets this tree's tempo so that, from `t_start`, it grows in a quarter of
        the cycle and its leaves have let go in time for the bare tree, the crumble
        and the next tree's first cell at t_start + cycle. Returns the moment the
        crumble should begin."""
        cfg = self.cfg
        units = max(1.0, self.growth_units())
        step = max(0.03, min(0.4, GROW_SHARE * cycle / units))
        grow = step * units
        crumble_at = t_start + cycle - (cfg["crumble"] + 4 + AVALANCHE + DEBRIS_HOLD)
        fall = (crumble_at - t_start) - grow - cfg["wait"] - cfg["autumn"] - LANDING_TAIL - BARE_TARGET
        self.cfg = dict(cfg, step=step, fall=max(60.0, fall))
        self.report["tempo"] = f"step {step:.3f} s, growing {grow:.0f} s, letting go over {self.cfg['fall']:.0f} s"
        return crumble_at

    def draw(self):
        """Draws the tree; returns 'key' or 'resize' if one interrupts it, else None."""
        cfg, attrs, grid = self.cfg, self.attrs, self.grid
        events, order = [], itertools.count()
        ready = collections.deque([self.strokes[0]])
        active = 0

        def start(t):
            nonlocal active
            while active < cfg["fronts"] and ready:
                s = ready.popleft()
                s.pos = 0
                active += 1
                heapq.heappush(events, (t + cfg["gap"] * cfg["step"], next(order), "stroke", s))

        def wood(s, i, attr):
            y, x, text, paint = s.cells[i]
            final = [attr if (paint is None or paint[k] in "bk") else attrs["dead"] if paint[k] in "dj"
                     else attrs["dead"] if paint[k] == "r" else 0
                     for k in range(len(text))]  # deadwood and a rock in the bleached tone; the void a blank
            if all(grid.get((y, x + k)) == ("wood", text[k], final[k]) for k in range(len(text))):
                return False  # already there, exactly so
            new = [(y, x + k) for k in range(len(text)) if (y, x + k) not in grid]
            k = 0
            while k < len(text):  # runs of one attribute
                j = k + 1
                while j < len(text) and final[j] == final[k]:
                    j += 1
                self.put(y, x + k, text[k:j], final[k])
                k = j
            for k in range(len(text)):
                grid[(y, x + k)] = ("wood", text[k], final[k])
            for cell in new:
                self.halo_add(cell)
            return True

        def leaf(s, i, t):
            y, x, char, attr = s.cells[i]
            under = grid.get((y, x))
            if under is not None and (y, x) not in s.cover:
                return False
            grid[(y, x)] = ("leaf", char, attr, under)  # the twig comes back when the leaf falls
            if under is None:
                self.halo_add((y, x))
            if cfg["bud_delay"]:
                self.put(y, x, ".", attrs["bud"])
                heapq.heappush(events, (t + cfg["bud_delay"] * cfg["step"], next(order),
                                        "bud", (y, x, char, attr)))
            else:
                self.put(y, x, char, attr)
            return True

        start(time.monotonic())
        while events:
            t = events[0][0]
            outcome = self.sleep_until(t)
            if outcome:
                return outcome
            _t, _n, kind, item = heapq.heappop(events)
            if kind == "bud":
                self.put(*item)
                continue
            s = item
            while s.pos < len(s.cells):  # cells that change nothing cost no time
                i = s.pos
                s.pos += 1
                if s.kind == "leaf":
                    changed = leaf(s, i, t)
                else:
                    changed = wood(s, i, attrs["tip"])
                    if changed:
                        if s.lit is not None:
                            wood(s, s.lit, attrs["wood"])  # the tip moves on
                        s.lit = i
                if changed:
                    break
            if s.pos < len(s.cells):
                heapq.heappush(events, (t + self.delay(s), next(order), "stroke", s))
            else:
                if s.lit is not None:
                    wood(s, s.lit, attrs["wood"])
                if s.kind == "trunk":
                    self.trunk_done = t
                ready.extend(s.after)
                active -= 1
            start(t)
        self.scr.refresh()
        return None

    # ---- autumn: the leaves turn, fall, and the bare tree crumbles ---------------------

    def restore(self, cell):
        """Puts back what the screen holds at `cell`: the tree, the planter, the carpet,
        else the sky, else blank."""
        entry = self.grid.get(cell)
        if entry is not None:
            self.put(cell[0], cell[1], entry[1], entry[2])
            return
        sky = self.sky.cell(cell) if self.sky else None
        if sky is not None:
            self.put(cell[0], cell[1], sky[0], sky[1])
        elif self.backdrop:
            self.put_raw(cell[0], cell[1], *self.backdrop.cell(*cell))
        else:
            self.put(cell[0], cell[1], " ", 0)

    def sleep_until(self, t):
        """Shows the screen and waits until time `t`, the sky moving meanwhile: 'key'
        or 'resize' if interrupted, else None."""
        while True:
            now = time.monotonic()
            if now >= t:
                return None
            self.scr.refresh()
            outcome = pause(self.scr, min(SKY_TICK, t - now))
            if outcome:
                return outcome
            if self.sky:
                self.sky.tick(time.monotonic(), self.grid, self.busy)

    def surface(self, x):
        """The ground a falling thing reaches at column x: the planter's soil row over
        the planter, a stand's top beside it, or the table at the bottom of the screen."""
        if x in self.pot_cols:
            return self.base
        if self.stand_span and self.stand_span[0] <= x <= self.stand_span[1]:
            return self.stand_top - 1
        return self.H - 1

    # The carpet behaves like a heap of leaves: a leaf falls into any hole under it,
    # slides down a slope until it rests on something, and the piles stay at most a
    # few rows high. "Passable" is where a leaf may lie: an empty cell, gravel, or the
    # far rim, which stands behind the pile.

    def passable(self, cell):
        y, x = cell
        if not (0 <= y < self.H and 0 <= x < self.W):
            return False
        entry = self.grid.get(cell)
        return entry is None or entry[0] == "soil" or (y == self.base - 1 and entry[0] == "pot")

    def is_carpet(self, cell):
        entry = self.grid.get(cell)
        return entry is not None and entry[0] in ("fallen", "dust")

    def land(self, y, x):
        """Where a leaf arriving at (y, x) comes to rest: it falls while there is
        nothing under it, slides down a slope while a lower cell beside it is free,
        and climbs over leaves already lying there. Returns the cell, or None."""
        rng = self.rng
        for _step in range(200):
            if y >= self.H - 1 and not self.passable((y, x)):
                return None
            if y + 1 < self.H and self.passable((y + 1, x)) and not self.is_carpet((y + 1, x)):
                y += 1  # nothing under it: it falls
                continue
            if self.passable((y, x)):
                sides = [-1, 1]
                rng.shuffle(sides)
                for dx in sides:  # a free lower cell beside it: it slides
                    nx = x + dx
                    if (self.passable((y, nx)) and y + 1 < self.H and self.passable((y + 1, nx))
                            and not self.is_carpet((y + 1, nx))):
                        y, x = y + 1, nx
                        break
                else:
                    return (y, x)
                continue
            if self.is_carpet((y, x)):
                y -= 1  # leaves lie here: it comes to rest higher up
                if y < 0:
                    return None
                continue
            return None  # something solid

    def settle(self, x, kind, char, attr):
        """Lays a fallen thing at column x, on the ground or on the pile there, by the
        heap's rules. Only a share of the leaves stay (`keep`); the rest vanish on
        touching down, and on the table only a quarter of those. A leaf meeting the
        trunk's base rolls off beside it. A pile stays within `pile` rows of its
        ground, and the overflow slides off the planter's ends."""
        top = self.surface(x)
        if self.rng.random() > self.cfg["keep"]:
            return False  # leaves and dust alike: only a share stays
        if top == self.H - 1 and self.rng.random() > 0.25:
            return False
        direction = self.rng.choice((-1, 1))
        for k in range(0, 9):  # off the trunk's base, to the nearest free column
            nx = x + direction * k
            if 0 <= nx < self.W and (self.passable((top, nx)) or self.is_carpet((top, nx))):
                x = nx
                break
            nx = x - direction * k
            if 0 <= nx < self.W and (self.passable((top, nx)) or self.is_carpet((top, nx))):
                x = nx
                break
        else:
            return False
        spot = self.land(top, x)
        if spot is None:
            return False
        y, x = spot
        if y < self.surface(x) - self.cfg["pile"]:
            return False  # the pile is as high as it gets
        entry = self.grid.get((y, x))
        self.grid[(y, x)] = (kind, char, attr, entry)
        self.put(y, x, char, attr)
        # Now and then a leaf landing on a slope knocks the one under it loose: that
        # one tumbles down the slope, and the newcomer drops into its place.
        below = (y + 1, x)
        if (kind == "fallen" and self.is_carpet(below) and self.rng.random() < 0.3
                and any(self.passable((y + 1, x + dx)) and self.passable((y + 2, x + dx))
                        and not self.is_carpet((y + 2, x + dx)) for dx in (-1, 1))):
            self.knock(below)
        return True

    def knock(self, cell):
        """Lifts the leaf at `cell` and lets it find its rest again; then whatever
        was resting on it comes down."""
        kind, char, attr, under = self.grid.pop(cell)
        if under is not None:
            self.grid[cell] = under
        self.restore(cell)
        spot = self.land(cell[0], cell[1])
        if spot is not None and spot != cell:
            entry = self.grid.get(spot)
            self.grid[spot] = (kind, char, attr, entry)
            self.put(spot[0], spot[1], char, attr)
        above = (cell[0] - 1, cell[1])
        if self.is_carpet(above) and (self.passable(cell) and not self.is_carpet(cell)):
            self.knock(above)

    def mulch(self):
        """A share of the buried leaves goes to mulch between one autumn and the next:
        the heap lowers a little before the new leaves come. Returns 'key' or 'resize'
        if interrupted, else None."""
        rng = self.rng
        buried = [c for c in self.grid if self.is_carpet(c) and self.is_carpet((c[0] - 1, c[1]))]
        gone = rng.sample(buried, int(len(buried) * MULCH))
        for cell in gone:
            under = self.grid.pop(cell)[3]
            if under is not None:
                self.grid[cell] = under
            self.restore(cell)
        return self.collapse() if gone else None

    def collapse(self):
        """After the ground under the carpet has changed, every leaf or grain of dust
        with nothing under it, or with a free lower cell beside it, falls or slides
        until the heap is stable: a small avalanche, drawn as it goes. Returns 'key' or
        'resize' if interrupted, else None."""
        t = time.monotonic()
        for _pass in range(12):
            cells = sorted((c for c in self.grid if self.is_carpet(c)), key=lambda c: (-c[0], self.rng.random()))
            moved = 0
            for y, x in cells:
                loose = (self.passable((y + 1, x)) and not self.is_carpet((y + 1, x))) or any(
                    self.passable((y, x + dx)) and self.passable((y + 1, x + dx)) and not self.is_carpet((y + 1, x + dx))
                    for dx in (-1, 1))
                if not loose:
                    continue
                kind, char, attr, under = self.grid.pop((y, x))
                if under is not None:
                    self.grid[(y, x)] = under
                self.restore((y, x))
                spot = self.land(y, x)
                if spot is not None and spot != (y, x):
                    entry = self.grid.get(spot)
                    self.grid[spot] = (kind, char, attr, entry)
                    self.put(spot[0], spot[1], char, attr)
                moved += 1
                if moved % 3 == 0:
                    t += TICK / 2
                    outcome = self.sleep_until(t)
                    if outcome:
                        return outcome
            if not moved:
                break
        return None

    def autumn(self):
        """The leaves change colour over `autumn` seconds, the top pad first and the
        lowest last, one here and one there: all to the first autumn colour, many on
        to the next, bright."""
        cfg, rng, turn = self.cfg, self.rng, self.attrs["turn"]
        if FOLIAGE[self.foliage]["autumn"] == "yellow" and cfg["autumn_colors"] == SETTINGS["autumn_colors"][0]:
            turn = turn[:1]  # needles and willow leaves go gold only
        leaves = [c for c, e in self.grid.items() if e[0] == "leaf" and c not in self.accents]
        if not leaves or not turn or cfg["autumn"] <= 0:
            return None
        leaves.sort(key=lambda c: c[0] + rng.uniform(-8, 8))
        T, n = cfg["autumn"], len(leaves)
        events = []
        for i, cell in enumerate(leaves):
            events.append((T * 0.7 * i / n, cell, 0))
            if len(turn) > 1 and rng.random() < 0.6:
                events.append((T * (0.5 + 0.5 * rng.random()), cell, 1))
        events.sort()
        t0 = time.monotonic()
        for t, (y, x), k in events:
            outcome = self.sleep_until(t0 + t)
            if outcome:
                return outcome
            _kind, char, _attr, under = self.grid[(y, x)]
            self.grid[(y, x)] = ("leaf", char, turn[k], under)
            self.put(y, x, char, turn[k])
        return None

    def fall(self):
        """The leaves let go a few a second, more in a gust every so often, and float
        down over `fall` seconds: swaying, gliding now and then, tumbling as they
        turn, carried by one slow breeze; they settle on the soil, a stand, or the
        table."""
        cfg, rng = self.cfg, self.rng
        leaves = [c for c, e in self.grid.items() if e[0] == "leaf"]
        if not leaves:
            return None
        rng.shuffle(leaves)
        # the blooms let go first, the fruit hangs on last
        leaves.sort(key=lambda c: {"bloom": 0, "fruit": 2}.get(self.accents.get(c), 1))
        n, total = len(leaves), cfg["fall"]
        gust_leaves = (total / 17.5) * 18.5  # what the gusts will carry
        base_per_tick = max(1.0, (n - gust_leaves) / total) * TICK
        flying, acc, i = [], 0.0, 0
        t0 = time.monotonic()
        t = t0
        next_gust = t0 + rng.uniform(10, 25)
        gust_end, gust_dir, gust_per_tick = t0, 1, 0.0
        while i < n or flying:
            wind = 0.3 * math.sin(2 * math.pi * (t - t0) / 30.0)  # the breeze everyone feels
            if t >= next_gust and i < n:
                gust_end = t + 2.0
                gust_dir = rng.choice((-1, 1))
                if self.sky:  # two gusts in three blow the way the clouds go
                    gust_dir = self.sky.wind if rng.random() < 2 / 3 else -self.sky.wind
                gust_per_tick = rng.randint(12, 25) / (2.0 / TICK)
                next_gust = gust_end + rng.uniform(10, 25)
            if t < gust_end:
                wind += 0.4 * gust_dir
                acc += gust_per_tick
            acc += base_per_tick
            while i < n and acc >= 1:  # a leaf lets go
                acc -= 1
                cell = leaves[i]
                i += 1
                _kind, _char, attr, under = self.grid.pop(cell)
                if under is not None:
                    self.grid[cell] = under
                else:
                    self.halo_drop(cell)
                period = rng.uniform(1.2, 2.5)
                flying.append({"y": float(cell[0]), "x": float(cell[1]), "attr": attr,
                               "vy": rng.uniform(0.25, 0.5), "amp": rng.uniform(2.0, 6.0),
                               "omega": 2 * math.pi * TICK / period, "phase": rng.uniform(0, 6.3),
                               "glide_next": t + rng.uniform(2, 4), "glide_end": t, "cell": cell})
            still = []
            for f in flying:
                f["x"] += wind
                gliding = t < f["glide_end"]
                if not gliding and t >= f["glide_next"]:
                    f["glide_end"] = t + rng.uniform(0.6, 1.0)
                    f["glide_next"] = f["glide_end"] + rng.uniform(2, 4)
                    gliding = True
                f["phase"] += f["omega"]
                s, c = math.sin(f["phase"]), math.cos(f["phase"])
                if gliding:  # a glide: nearly level, sliding the way it sways
                    f["y"] += 0.1
                    f["x"] += 0.5 if c > 0 else -0.5
                else:
                    f["y"] += f["vy"]
                glyph = "&" if abs(s) > 0.7 else "*" if abs(s) > 0.3 else ("'" if c > 0 else ",")
                x = max(0, min(self.W - 1, int(round(f["x"] + f["amp"] * s))))
                y = int(round(f["y"]))
                if y >= self.surface(x):  # lands as it was turning, in its colour
                    self.restore(f["cell"])
                    self.settle(x, "fallen", glyph, f["attr"] & ~curses.A_BOLD)
                    continue
                if (y, x) != f["cell"]:
                    self.restore(f["cell"])
                    f["cell"] = (y, x)
                self.put(y, x, glyph, f["attr"])
                still.append(f)
            flying = still
            self.busy = {f["cell"] for f in flying}
            t += TICK
            outcome = self.sleep_until(t)
            if outcome:
                return outcome
        return None

    def crumble(self):
        """The bare tree crumbles over `crumble` seconds, the branches from their tips
        inward, then the trunks from the top down, the dust drifting into the planter
        and lying there a while with the fallen leaves; the next tree grows out of it."""
        cfg, rng = self.cfg, self.rng
        steps = []
        branches = [s for s in self.strokes if s.kind in BRANCH_KINDS]
        for d in range(max((len(s.cells) for s in branches), default=0)):
            steps.append([(s.cells[len(s.cells) - 1 - d][0], s.cells[len(s.cells) - 1 - d][1])
                          for s in branches if d < len(s.cells)])
        rows = {}
        for s in self.strokes:
            if s.kind in TRUNK_KINDS:
                for y, x0, text, _a in s.cells:
                    rows.setdefault(y, []).extend((y, x0 + k) for k in range(len(text)))
        for y in sorted(rows):
            steps.append(rows[y])
        seen = set()
        steps = [[c for c in dict.fromkeys(step) if self.grid.get(c, (None,))[0] == "wood"
                  and c not in seen and not seen.add(c)] for step in steps]
        per_step = cfg["crumble"] / max(1, len(steps))
        dust, k = [], 0
        t = time.monotonic()
        next_step = t
        while k < len(steps) or dust:
            while k < len(steps) and t >= next_step - 1e-9:
                for y, x in steps[k]:
                    if self.grid.pop((y, x), None) is not None:
                        self.halo_drop((y, x))
                    self.restore((y, x))
                    if rng.random() < 0.5:
                        dust.append({"y": float(y), "x": max(0, min(self.W - 1, x + rng.choice((-1, 0, 0, 1)))),
                                     "vy": rng.uniform(1.0, 1.8), "char": rng.choice(".:'"), "cell": None})
                k += 1
                next_step += per_step
            still = []
            for d in dust:
                if d["cell"]:
                    self.restore(d["cell"])
                d["y"] += d["vy"]
                y, x = int(round(d["y"])), d["x"]
                if y >= self.surface(x):
                    self.settle(x, "dust", ":", self.attrs["wood"])
                    continue
                self.put(y, x, d["char"], self.attrs["wood"])
                d["cell"] = (y, x)
                still.append(d)
            dust = still
            self.busy = {d["cell"] for d in dust}
            t += TICK
            outcome = self.sleep_until(t)
            if outcome:
                return outcome
        outcome = self.collapse()  # the heap settles into the space the trunk left
        if outcome:
            return outcome
        outcome = self.sleep_until(time.monotonic() + DEBRIS_HOLD)
        if outcome:
            return outcome
        self.draw_pot(top_only=True)  # the rim and the gravel the trunk stood over come back
        return None


def pause(scr, seconds):
    """Wait, watching the keyboard: 'key', 'resize', or None when the time is up."""
    end = time.monotonic() + seconds
    while True:
        scr.timeout(max(0, int((end - time.monotonic()) * 1000)))
        ch = scr.getch()
        if ch == curses.KEY_RESIZE:
            return "resize"
        if ch != -1:
            return "key"
        if time.monotonic() >= end:
            return None


def clear_softly(scr, seconds):
    """Clears the screen one row at a time from the top."""
    rows, _cols = scr.getmaxyx()
    for y in range(rows):
        try:
            scr.move(y, 0)
            scr.clrtoeol()
        except curses.error:
            pass
        scr.refresh()
        outcome = pause(scr, seconds / rows)
        if outcome:
            return outcome
    return None


def run_tree(scr, cfg, tree, t_start, once=False):
    """Grows the tree from `t_start` and takes it through its autumn. With a cycle
    set, the tree is paced so the next one's first cell lands at t_start + cycle:
    the bare tree stands until the crumble's moment, and nothing is cut short."""
    cycle = cfg["cycle"]
    crumble_at = tree.pace(cycle, t_start) if cycle else None
    if tree.sky:
        tree.sky.new_tree(time.monotonic(), cycle, tree.base)
    outcome = tree.draw()
    if outcome is None:
        outcome = tree.sleep_until(time.monotonic() + cfg["wait"])
    if outcome is None and not once:
        def bare():
            if crumble_at is not None:
                return tree.sleep_until(crumble_at)
            return tree.sleep_until(time.monotonic() + cfg["bare"])

        def mark():
            return tree.sleep_until(t_start + cycle) if crumble_at is not None else None

        for phase in (tree.mulch, tree.autumn, tree.fall, bare, tree.crumble, mark):
            outcome = phase()
            if outcome:
                break
    return outcome


def screensaver(scr, args, cfg):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    seed = cfg["seed"]
    rng = random.Random(seed)
    inherit = None  # the planter on the screen and the carpet in it, for the next tree
    scr.erase()
    rows, cols = scr.getmaxyx()
    if rows < SMALLEST[0] or cols < SMALLEST[1]:  # no room for a tree: say so and wait for the key
        word = f"a bonsai needs {SMALLEST[1]} by {SMALLEST[0]}; this is {cols} by {rows}"
        try:
            scr.addstr(rows // 2, max(0, (cols - len(word)) // 2), word[:cols])
        except curses.error:
            pass
        scr.refresh()
        while pause(scr, 3600) != "key":
            pass
        return
    t_start = time.monotonic()
    sky = None
    backdrop = None
    while True:
        try:
            fresh = settings(args)  # re-read, so an edit shows on the next tree
        except ValueError:
            fresh = cfg  # a half-saved edit keeps the last good settings
        if fresh["seed"] != seed:
            seed = fresh["seed"]
            rng = random.Random(seed)
        cfg = fresh
        attrs = make_attrs(cfg)
        if backdrop is None and cfg["sky"] and cfg["landscape"] != "no" and curses.has_colors():
            # The landscape: once per run (and again after a resize), the same place for
            # every tree; the console's palette set to its colours where that is allowed.
            backdrop = Backdrop(cols, rows, seed if seed is not None else random.randrange(1 << 30),
                                PAIRS, fallback=not set_palette(PALETTE_DAY))
            backdrop.draw(scr)
            attrs = make_attrs(cfg)  # the clouds' slots follow the palette just set
        if sky is None and cfg["sky"]:
            sky = Sky(scr, random.Random(None if seed is None else f"sky {seed}"), attrs)
            sky.setup(cfg, backdrop)
            # Five minutes of sky before the first tree, so it is not born under an empty one.
            sky.new_tree(time.monotonic() - 300, cfg["cycle"], scr.getmaxyx()[0] - 1)
            for t in range(300, 0, -1):
                sky.tick(time.monotonic() - t, {}, draw=False)
        elif sky is not None and not cfg["sky"]:
            sky.clouds, sky.events = [], []
            sky.tick(time.monotonic(), {})
            sky = None
        if backdrop:
            backdrop.halo.clear()
        tree = Tree(scr, cfg, rng, attrs, inherit)
        tree.sky, tree.backdrop = sky, backdrop
        if sky:
            sky.attrs = attrs
            sky.amounts(cfg)
        if inherit is None:
            tree.draw_pot()
        log_path = os.environ.get("XUUXIJ_BONSAI_LOG")  # for timing checks only
        if log_path:
            with open(log_path, "a", encoding="utf-8") as fh:
                fh.write(f"{time.time():.1f} {time.monotonic() - t_start:+.1f}s off the mark: "
                         f"{tree.style}{' twin' if tree.twin else ''} in {tree.report['planter']}\n")
        outcome = run_tree(scr, cfg, tree, t_start, args.once)
        if outcome == "key" or (args.once and outcome is None):
            return
        # The next tree starts on the mark, the clock anchored to the first tree's
        # start so a late landing never drifts the timer; without a cycle, right away.
        t_start = t_start + cfg["cycle"] if cfg["cycle"] else time.monotonic()
        if outcome == "resize":
            inherit, sky, backdrop = None, None, None  # a new sky and landscape for the new screen
            scr.erase()
            rows, cols = scr.getmaxyx()
            t_start = time.monotonic()
        elif tree.planter_spec() is not None:
            inherit = {"planter": tree.planter_spec(), "grid": tree.grid}


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        cfg = settings(args)
    except ValueError as exc:
        print(f"xuuxij-bonsai: {exc}", file=sys.stderr)
        return 2
    if args.print_config:
        for key in SETTINGS:
            print(f"{key} = {show(cfg[key])}")
        return 0
    os.environ.setdefault("ESCDELAY", "25")  # Esc ends it at once, like any key
    try:
        curses.wrapper(screensaver, args, cfg)
    except KeyboardInterrupt:
        pass
    finally:
        reset_palette()
    return 0


if __name__ == "__main__":
    sys.exit(main())

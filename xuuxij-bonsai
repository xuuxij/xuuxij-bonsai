# ---- the planters ------------------------------------------------------------------
# Each design is a function of an odd width W returning rows of (text, paint); paint
# has one letter per cell: b body colour, B body + bold (a lit lip, sheen, relief
# catching the light), t trim colour, T trim + bold (gold bands, white studs), g gravel,
# m moss, s the cast shadow (dark grey), space = nothing drawn. The trunk stands on the
# SOIL row (row 1 of every pot); row 0 is the far rim, seen over the soil, and the trunk
# draws over it. The pot is drawn before the tree. After the Omiya Bonsai Art Museum's
# pots B-003 and B-321, the Teizan and Yixing rectangles with cloud feet, the hexagonal
# cascade pots, and the Chinese rosewood stands with openwork aprons.

SOIL = ". : , . : . , : . "


def soil(n, offset=0):
    """n cells of gravel with three small moss patches (two on a narrow pot)."""
    text = "".join(SOIL[(i + offset) % len(SOIL)] for i in range(n))
    paint = ["g" if c != " " else " " for c in text]
    patches = (n // 6, n // 2 + 4, n - n // 6 - 3) if n >= 36 else (n // 5, n - n // 5 - 3)
    for start in patches:
        for k in range(3):
            if 0 <= start + k < n:
                text = text[: start + k] + ",,'"[k] + text[start + k + 1:]
                paint[start + k] = "m"
    return text, "".join(paint)


def run(n, core, link="", filler=" "):
    """core (link core)*k centred in n cells; leftover is filler, split both sides."""
    k = max(0, (n - len(core)) // (len(core) + len(link)))
    s = core + (link + core) * k
    left = (n - len(s)) // 2
    return filler * left + s + filler * (n - len(s) - left)


def row(parts):
    text = "".join(p[0] for p in parts)
    paint = "".join(p[1] if len(p[1]) == len(p[0]) else p[1] * len(p[0]) for p in parts)
    return text, paint


def shadow(W, inset):
    """The cast shadow on the table, a cell longer to the right (light from the left)."""
    inset = max(1, inset)
    return row([(" " * inset, " "), ("-" * (W - 2 * inset + 1), "s"), (" " * (inset - 1), " ")])


def soil_row(W, capl, capr):
    st, sp = soil(W - len(capl) - len(capr) - 2)
    return row([(capl, "b"), (" ", " "), (st, sp), (" ", " "), (capr, "b")])


def pot_drum(W):
    """Studded drum (after B-321, a white Cochin drum pot): nail-head stud bands top and
    bottom, a low body, a foot ring. Round pots suit any informal tree."""
    def studs():
        return row([("(", "b"), (run(W - 2, "o", "___", "_"), "T"), (")", "b")])
    return [
        row([("   .-", "B"), ("=" * (W - 10), "B"), ("-.   ", "B")]),
        soil_row(W, " .'", "`. "),
        studs(),
        row([("|", "b"), ("=" * (W - 2), "B"), ("|", "b")]),
        row([("|", "b"), ("=" * (W - 2), "b"), ("|", "b")]),
        studs(),
        row([(" \\", "b"), ("_" * (W - 4), "b"), ("/ ", "b")]),
        row([("    (", "b"), ("_" * (W - 10), "b"), (")    ", "b")]),
        shadow(W, 3),
    ]


def pot_celadon(W):
    """Round celadon pot (after B-003): a wavy rim, a running floral scroll in relief
    on the upper body, a lotus-petal relief below, a foot ring. One colour: the relief
    reads as light catching the raised parts."""
    n = W - 2
    return [
        row([(" ", " "), (run(W - 2, "_.-~-.", "", "_"), "B"), (" ", " ")]),
        soil_row(W, "(", ")"),
        row([("(", "B"), (run(W - 2, ".-~-.", "_", "_"), "B"), (")", "B")]),
        row([("|", "b"), (run(n, " _.-._    "), "B"), ("|", "b")]),
        row([("|", "b"), (run(n, "'     `-.-"), "B"), ("|", "b")]),
        row([("|", "b"), ("=" * n, "b"), ("|", "b")]),
        row([("|", "b"), (run(n, "\\  /"), "B"), ("|", "b")]),
        row([("|", "b"), (run(n, " \\/ "), "b"), ("|", "b")]),
        row([(" \\", "b"), ("_" * (W - 4), "b"), ("/ ", "b")]),
        row([("   (", "b"), ("_" * (W - 8), "b"), (")   ", "b")]),
        shadow(W, 2),
    ]


def pot_teizan(W):
    """Rectangle with an open lip, a carved key-fret band and cloud feet (after the
    Teizan and Yixing rectangles). Deep, angular, stout feet: the pot for an upright."""
    n = W - 4
    return [
        row([("  ", " "), ("_" * (W - 4), "B"), ("  ", " ")]),
        soil_row(W, " |", "| "),
        row([("|", "B"), ("_" * (W - 2), "B"), ("|", "B")]),
        row([(" |", "b"), ("=" * n, "B"), ("| ", "b")]),
        row([(" |", "b"), ("=" * n, "b"), ("| ", "b")]),
        row([(" |", "b"), (run(n, " ___  "), "T"), ("| ", "b")]),
        row([(" |", "b"), (run(n, "|  _| "), "T"), ("| ", "b")]),
        row([(" |", "b"), (run(n, "|_|   "), "T"), ("| ", "b")]),
        row([(" |", "b"), ("_" * n, "b"), ("| ", "b")]),
        row([("   (_o)", "b"), (" " * (W - 14), " "), ("(o_)   ", "b")]),
        shadow(W, 2),
    ]


def pot_hexagon(W):
    """Tall six-sided cascade pot (as tall as it is wide): flared lip, dark side facets,
    a diamond lattice band, block feet. For the cascade and the narrow tree."""
    n = W - 6

    def face(fill, p):
        return row([("|", "b"), ("#|", "b"), (fill, p), ("|#", "b"), ("|", "b")])
    return [
        row([("  .", "B"), ("_" * (W - 6), "B"), (".  ", "B")]),
        soil_row(W, " /", "\\ "),
        row([("/", "B"), ("_" * (W - 2), "B"), ("\\", "B")]),
        face("=" * n, "B"),
        face(run(n, " /\\ "), "T"),
        face(run(n, "<  >"), "T"),
        face(run(n, " \\/ "), "T"),
        face("=" * n, "b"),
        face("=" * n, "b"),
        face("=" * n, "b"),
        face("_" * n, "b"),
        row([(" \\", "b"), ("_" * (W - 4), "b"), ("/ ", "b")]),
        row([("   [_]", "b"), (" " * (W - 12), " "), ("[_]   ", "b")]),
        shadow(W, 2),
    ]


def pot_oval(W):
    """Glazed oval with a rolled lip, a running wave scroll in relief, soft lines and
    delicate feet: the pot for the wide informal or slanting tree."""
    n = W - 6
    return [
        row([("    __.--", "B"), ("~" * (W - 18), "B"), ("--.__    ", "B")]),
        soil_row(W, "  .-~'", "`~-.  "),
        row([(" (", "B"), ("=" * (W - 4), "B"), (") ", "B")]),
        row([("  \\", "b"), (run(n, " _.-._    "), "B"), ("/  ", "b")]),
        row([("   \\", "b"), (run(n, "'     `-.-")[1:-1], "B"), ("/   ", "b")]),
        row([("    \\", "b"), ("=" * (W - 10), "b"), ("/    ", "b")]),
        row([("     \\", "b"), ("=" * (W - 12), "b"), ("/     ", "b")]),
        row([("      \\", "b"), ("_" * (W - 14), "b"), ("/      ", "b")]),
        row([("        (__)", "b"), (" " * (W - 24), " "), ("(__)        ", "b")]),
        shadow(W, 6),
    ]


def pot_bunjin(W):
    """The literati pot: shallow, round, plain, with a wavy rim; the ornament is the
    tall stand under it."""
    return [
        row([("  .", "B"), ("-" * (W - 6), "B"), (".  ", "B")]),
        soil_row(W, " (", ") "),
        row([("(", "B"), (run(W - 2, ".-~-.", "_", "_"), "B"), (")", "B")]),
        row([(" \\", "b"), ("_" * (W - 4), "b"), ("/ ", "b")]),
        row([("   (", "b"), ("_" * (W - 8), "b"), (")   ", "b")]),
    ]


STAND_LEGS = {"stand": 0, "tall": 3, "cascade": 24}


def stand_rows(W, stand):
    """Rosewood stand (after the Chinese rosewood stands: an openwork apron cut in
    cusps, cabriole legs, scroll feet, a stretcher). The pot's feet stand on row 0.
    `tall` adds leg rows for the literati display, `cascade` many more for a tree
    that hangs beside it."""
    n = W - 2
    legs = [row([("|", "b"), (" " * n, " "), ("|", "b")])] * STAND_LEGS[stand]
    return [
        row([(" ", " "), ("_" * n, "B"), (" ", " ")]),
        row([("|", "b"), ("_" * n, "b"), ("|", "b")]),
        row([("|", "b"), (run(n, "  ___ ", "", " "), "b"), ("|", "b")]),
        row([("|", "b"), (run(n, "_/   \\", "", "_"), "b"), ("|", "b")]),
    ] + legs + [
        row([("(_/", "b"), ("_" * (W - 6), "b"), ("\\_)", "b")]),
        shadow(W, 0),
    ]



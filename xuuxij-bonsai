def read_blocks(path):
    """A user file: `key: value` lines, and `rows:` / `paint:` headings followed by
    their lines kept as they are. Returns (values, blocks), with line numbers."""
    values, blocks, current = {}, {}, None
    with open(path, encoding="utf-8") as fh:
        for number, raw in enumerate(fh.read().splitlines(), 1):
            line = raw.rstrip("\n")
            if current is None and (not line.strip() or line.lstrip().startswith("#")):
                continue
            if line.strip().lower() in ("rows:", "paint:"):
                current = line.strip().lower()[:-1]
                blocks[current] = []
                continue
            if current is not None:
                if ":" in line and not line.startswith(" ") and line.split(":", 1)[0].strip().isalpha() \
                        and line.split(":", 1)[0].strip().lower() not in ("rows", "paint"):
                    current = None  # a key again: the block ended
                else:
                    blocks[current].append(line)
                    continue
            if ":" not in line:
                raise ValueError(f"{path} line {number}: expected key: value")
            key, value = line.split(":", 1)
            value = re.split(r"\s+#", value, maxsplit=1)[0]  # a comment after the value
            values[key.strip().lower()] = (value.strip(), number)
    for name in blocks:
        while blocks[name] and not blocks[name][-1].strip():
            blocks[name].pop()
    return values, blocks


def load_user_pot(path):
    """A planter drawn in a file: its rows (row 1 the far rim, row 2 the soil the trunk
    stands on), optionally a paint block of the same shape, body and trim colours."""
    values, blocks = read_blocks(path)
    rows = blocks.get("rows")
    if not rows or len(rows) < 2:
        raise ValueError(f"{path}: needs a rows: block of at least two lines (the far rim, then the soil)")
    width = max(len(r) for r in rows)
    if width < 9:
        raise ValueError(f"{path}: the planter must be at least 9 columns wide")
    rows = [r.ljust(width) for r in rows]
    paint = blocks.get("paint")
    if paint is not None:
        paint = [p.ljust(width) for p in paint]
        if len(paint) != len(rows) or any(len(p) > width for p in paint):
            raise ValueError(f"{path}: the paint: block must have the same shape as rows:")
        bad = {c for p in paint for c in p if c not in "bBtTgms "}
        if bad:
            raise ValueError(f"{path}: paint letters must be b B t T g m s or space, not {''.join(sorted(bad))!r}")
    else:
        paint = []
        for i, r in enumerate(rows):
            if i == 1:  # the soil row: gravel and moss in the pot's own colours
                paint.append("".join(" " if c == " " else "g" if c in ".:" else "m" if c in ",'" else "b" for c in r))
            elif i == len(rows) - 1 and set(r.strip()) == {"-"}:
                paint.append("".join(" " if c == " " else "s" for c in r))
            else:
                paint.append("".join(" " if c == " " else "b" for c in r))
    for name in ("body", "trim"):
        if name in values and values[name][0].lower() not in COLORS:
            raise ValueError(f"{path} line {values[name][1]}: {name} must be one of {', '.join(COLORS)}")
    body = values.get("body", ("white", 0))[0].lower()
    trim = values.get("trim", (body, 0))[0].lower()
    return list(zip(rows, paint)), (body, trim)


def parse_number(text, name, path, number):
    try:
        if "to" in text:
            a, b = (float(p) for p in text.split("to", 1))
            return (a, b)
        if text.count("-") == 1 and not text.startswith("-"):
            a, b = (float(p) for p in text.split("-", 1))
            return (a, b)
        return float(text)
    except ValueError:
        raise ValueError(f"{path} line {number}: {name} must be a number or a range like 0.5 to 0.7, not {text!r}") from None


def load_user_form(path):
    """A form written over a base form: `base: moyogi` and the numbers to change."""
    values, _blocks = read_blocks(path)
    base = values.get("base", ("moyogi", 0))[0].lower()
    if base not in FORMS:
        raise ValueError(f"{path}: base must be one of {', '.join(FORMS)}, not {base!r}")
    spec = dict(FORMS[base])
    spec["weight"] = 10
    for key, (text, number) in values.items():
        key = key.replace(" ", "_")
        if key in ("base", "name"):
            continue
        if key in ("height", "spread", "movement", "apex", "lean", "bow", "first_branch", "apex_pad", "planting", "weight"):
            value = parse_number(text, key, path, number)
            if key == "planting":
                rule = spec["planting"][1]
                spec[key] = (value, rule)
            elif key in ("weight",):
                spec[key] = int(value)
            else:
                spec[key] = value
        elif key == "branches":
            value = parse_number(text, key, path, number)
            spec[key] = (int(value[0]), int(value[1])) if isinstance(value, tuple) else (int(value), int(value))
        elif key == "trunk_width":
            value = parse_number(text, key, path, number)
            lo, hi = (int(value[0]), int(value[1])) if isinstance(value, tuple) else (int(value), int(value))
            spec[key] = ("drawn", lo, hi)
        elif key == "branch_length":
            value = parse_number(text, key, path, number)
            spec[key] = (int(value[0]), int(value[1])) if isinstance(value, tuple) else (int(value), int(value))
        elif key == "twigs":
            spec[key] = 1 if text.lower() in ("1", "yes", "true") else 0
        elif key == "back_pad":
            spec[key] = text.lower() in ("yes", "true", "1")
        elif key == "first_side":
            if text.lower() not in ("outside", "away", "either", "with"):
                raise ValueError(f"{path} line {number}: first side must be outside, away, either or with")
            spec[key] = text.lower()
        elif key == "profile":
            if text.lower() not in ("curve", "chokkan", "shakan", "wind", "droop"):
                raise ValueError(f"{path} line {number}: profile must be curve, chokkan, shakan, wind or droop")
            spec[key] = text.lower()
        elif key == "leaves":
            spec[key] = text
        elif key == "planter":
            name = text.lower()
            if name != "wide" and name not in POTS and name not in USER_POTS:
                raise ValueError(f"{path} line {number}: planter must be wide or a planter's name")
            spec[key] = name
        else:
            raise ValueError(f"{path} line {number}: unknown setting {key!r} for a form")
    return spec


def load_user_files():
    """Reads the user's planters and forms once; a bad file is reported and skipped."""
    USER_POTS.clear()
    USER_FORMS.clear()
    for kind, folder, loader, store in (("planter", "pots", load_user_pot, USER_POTS),
                                        ("form", "styles", load_user_form, USER_FORMS)):
        path = os.path.join(USER_DIR, folder)
        if not os.path.isdir(path):
            continue
        for entry in sorted(os.listdir(path)):
            if not entry.endswith(".txt"):
                continue
            name = entry[:-4].lower()
            if name in POTS or name in FORMS or name == "kengai" or name in ("auto", "no", "wide"):
                print(f"xuuxij-bonsai: {kind} {name!r} ({entry}) has a built-in name; skipped", file=sys.stderr)
                continue
            try:
                store[name] = loader(os.path.join(path, entry))
            except (ValueError, OSError) as exc:
                print(f"xuuxij-bonsai: {kind} file skipped: {exc}", file=sys.stderr)


load_user_files()


def convert(key, raw):
    """One setting's text as its value; ValueError says what is wrong with it."""
    _default, kind, low, high, _text = SETTINGS[key]
    text = str(raw).strip()
    if kind is bool:
        if text.lower() in ("yes", "true", "on", "1"):
            return True
        if text.lower() in ("no", "false", "off", "0"):
            return False
        raise ValueError(f"{key} must be yes or no, not {text!r}")
    if kind == "color":
        if text.lower() not in COLORS:
            raise ValueError(f"{key} must be one of {', '.join(COLORS)}, not {text!r}")
        return text.lower()
    if kind == "color_auto":
        if text.lower() == "auto":
            return "auto"
        if text.lower() not in COLORS:
            raise ValueError(f"{key} must be auto or one of {', '.join(COLORS)}, not {text!r}")
        return text.lower()
    if kind == "colors":
        names = text.lower().split()
        bad = [n for n in names if n not in COLORS]
        if not names or bad:
            raise ValueError(f"{key} must be one or more of {', '.join(COLORS)}, not {text!r}")
        return " ".join(names)
    if kind == "style":
        name = text.lower()
        if name == "auto" or name in STYLES or name in USER_FORMS:
            return name
        raise ValueError(f"style must be auto or one of {', '.join(STYLES + tuple(USER_FORMS))}, not {text!r}")
    if kind == "weights":
        weights = {}
        for item in text.lower().split():
            name, _sep, number = item.partition(":")
            if (name not in STYLES and name not in USER_FORMS) or not number.isdigit():
                raise ValueError(f"{key} must be name:weight pairs with names from "
                                 f"{', '.join(STYLES + tuple(USER_FORMS))}, not {item!r}")
            weights[name] = int(number)
        if not any(weights.values()):
            raise ValueError(f"{key} needs at least one weight above 0")
        return " ".join(f"{n}:{w}" for n, w in weights.items())
    if kind == "duration":
        m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smh]?)", text.lower())
        if not m:
            raise ValueError(f"{key} must be a time like 10m, 90s or 600, or 0, not {text!r}")
        seconds = float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]
        if seconds and seconds < 120:
            raise ValueError(f"{key} must be 0 or at least two minutes, not {text!r}")
        return seconds
    if kind == "twin":
        name = text.lower()
        if name == "auto":
            return "auto"
        if name in ("yes", "true", "on", "1"):
            return "yes"
        if name in ("no", "false", "off", "0"):
            return "no"
        raise ValueError(f"twin must be auto, yes or no, not {text!r}")
    if kind == "leaves":
        if text.lower() == "auto":
            return "auto"
        if not text:
            raise ValueError("leaves needs at least one character, or auto")
        return text
    if kind in ("foliage", "bark"):
        names = tuple(FOLIAGE) if kind == "foliage" else BARKS
        if text.lower() == "auto":
            return "auto"
        if text.lower() not in names:
            raise ValueError(f"{key} must be auto or one of {', '.join(names)}, not {text!r}")
        return text.lower()
    if kind in ("foliage_weights", "bark_weights"):
        names = tuple(FOLIAGE) if kind == "foliage_weights" else BARKS
        if text.lower() == "auto":
            return "auto"
        weights = {}
        for item in text.lower().split():
            name, _sep, number = item.partition(":")
            if name not in names or not number.isdigit():
                raise ValueError(f"{key} must be auto or name:weight pairs with names from "
                                 f"{', '.join(names)}, not {item!r}")
            weights[name] = int(number)
        if not any(weights.values()):
            raise ValueError(f"{key} needs at least one weight above 0")
        return " ".join(f"{n}:{w}" for n, w in weights.items())
    if kind == "pot":
        name = text.lower()
        if name in ("yes", "true", "on", "1", "auto"):
            return "auto"
        if name in ("no", "false", "off", "0", "none"):
            return "no"
        if name in POTS or name in USER_POTS:
            return name
        raise ValueError(f"pot must be auto, no or one of {', '.join(list(POTS) + list(USER_POTS))}, not {text!r}")
    if kind == "clouds":
        name = text.lower()
        if name in ("auto", "ink", "tonal"):
            return name
        raise ValueError(f"clouds must be auto, ink or tonal, not {text!r}")
    if kind in ("stand", "tristate"):
        name = text.lower()
        if name == "auto":
            return "auto"
        if name in ("yes", "true", "on", "1"):
            return "yes"
        if name in ("no", "false", "off", "0", "none"):
            return "no"
        raise ValueError(f"{key} must be auto, yes or no, not {text!r}")
    if kind == "seed":
        if text.lower() in ("", "none", "random"):
            return None
        try:
            return int(text)
        except ValueError:
            raise ValueError(f"seed must be a whole number or none, not {text!r}") from None
    if kind is str:
        if not text:
            raise ValueError(f"{key} needs at least one character")
        return text
    try:
        value = kind(text)
    except ValueError:
        what = "a whole number" if kind is int else "a number"
        raise ValueError(f"{key} must be {what}, not {text!r}") from None
    if not low <= value <= high:
        raise ValueError(f"{key} must be between {low:g} and {high:g}, not {text}")
    return value


def load_config(path):
    """The defaults, overlaid with the settings file (a missing file is fine)."""
    cfg = {key: spec[0] for key, spec in SETTINGS.items()}
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        return cfg
    for number, line in enumerate(lines, 1):
        if line.lstrip().startswith("#"):
            continue
        line = re.split(r"\s+#", line, maxsplit=1)[0].strip()
        if not line:
            continue
        if "=" not in line:
            raise ValueError(f"{path} line {number}: expected key = value")
        key, value = (part.strip() for part in line.split("=", 1))
        if key not in SETTINGS:
            raise ValueError(f"{path} line {number}: unknown setting {key!r}")
        try:
            cfg[key] = convert(key, value)
        except ValueError as exc:
            raise ValueError(f"{path} line {number}: {exc}") from None
    return cfg


def parse_args(argv):
    p = argparse.ArgumentParser(prog="xuuxij-bonsai", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", default=CONFIG_PATH, help="settings file (default %(default)s)")
    for key, (default, kind, _low, _high, text) in SETTINGS.items():
        flag = "--" + key.replace("_", "-")
        if kind is bool:
            p.add_argument(flag, dest=key, action=argparse.BooleanOptionalAction, default=None,
                           help=f"{text} (default {'yes' if default else 'no'})")
        else:
            p.add_argument(flag, dest=key, default=None, metavar="VALUE",
                           help=f"{text} (default {show(default)})")
    p.add_argument("--once", action="store_true", help="grow one tree, hold, then exit")
    p.add_argument("--print-config", action="store_true",
                   help="print the settings a run would use, then exit")
    return p.parse_args(argv)


def settings(args):
    """The file's settings with the command line's flags on top."""
    cfg = load_config(args.config)
    for key in SETTINGS:
        value = getattr(args, key)
        if value is None:
            continue
        try:
            cfg[key] = value if isinstance(value, bool) else convert(key, value)
        except ValueError as exc:
            raise ValueError(f"--{key.replace('_', '-')}: {exc}") from None
    return cfg


def show(value):
    if isinstance(value, bool):
        return "yes" if value else "no"
    if value is None:
        return "none"
    if isinstance(value, float):
        return f"{value:g}"
    return str(value)


GROW_SHARE = 0.25     # of a timed cycle: the growing
BARE_TARGET = 20.0    # seconds the bare tree stands in a timed cycle, give or take the fall's tail
LANDING_TAIL = 22.0   # seconds the last leaves take to land after the release window


def set_palette(palette):
    """Gives the console's colour slots the exact RGB of `palette` (slot -> (hex, use)),
    where the terminal allows it: the Linux console by its own sequence (all sixteen
    slots), another terminal through curses. Returns whether it was done."""
    global PALETTE_WAY
    term = os.environ.get("TERM", "")
    if term.startswith("linux"):
        sys.stdout.write("".join("\033]P%x%02x%02x%02x" % ((slot,) + hex_rgb(rgb))
                                 for slot, (rgb, _use) in palette.items()))
        sys.stdout.flush()
        PALETTE_WAY = "linux"
    elif curses.has_colors() and curses.can_change_color():
        for slot, (rgb, _use) in palette.items():
            if slot < curses.COLORS:
                r, g, b = hex_rgb(rgb)
                curses.init_color(slot, r * 1000 // 255, g * 1000 // 255, b * 1000 // 255)
        PALETTE_WAY = "curses"
    return PALETTE_WAY is not None


def reset_palette():
    """Puts the console's palette back as it was (after curses has let go of the screen)."""
    if PALETTE_WAY == "linux":
        sys.stdout.write("\033]R")
    elif PALETTE_WAY == "curses":
        sys.stdout.write("\033]104\033\\")
    sys.stdout.flush()


def make_attrs(cfg, live=True):
    """Screen attributes: every console colour as a pair, and the parts drawn in them."""
    global PAIRS
    if PAIRS is None:
        PAIRS = Pairs(live)
        if live and curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
            except curses.error:
                PAIRS.default = curses.COLOR_BLACK
    if not live or curses.has_colors():
        color = {name: PAIRS.attr(number) for name, number in COLORS.items()}
    else:
        color = {name: curses.A_NORMAL for name in COLORS}
    wood, leaf = color[cfg["trunk_color"]], color[cfg["leaf_color"]]
    return {"color": color,
            "wood": wood,
            "tip": wood | curses.A_BOLD if cfg["highlight"] else wood,
            "leaf": (leaf, leaf | curses.A_BOLD), "leaf_under": color["black"], "bud": leaf, "moss": leaf,
            "gravel": color["white"], "shadow": color["black"] | curses.A_BOLD,
            "stand": color[cfg["stand_color"]],
            "turn": [color[name] | curses.A_BOLD for name in cfg["autumn_colors"].split()],
            # bleached deadwood: the clouds' white over the landscape (the brightest grey the
            # palette keeps), the console's white on a black sky
            "dead": color["magenta"] | curses.A_BOLD if PALETTE_WAY else color["white"],
            "bloom": color["red"] | curses.A_BOLD, "rosebud": color["red"], "fruit": color["yellow"] | curses.A_BOLD,
            # The clouds' three greys: over a landscape (its palette set) the tops take the
            # magenta slot, which the landscape leaves free, so the clouds keep their own
            # light however dim the landscape is; on a plain console, bold white.
            "W": color["magenta" if PALETTE_WAY else "white"] | curses.A_BOLD, "g": color["white"],
            "d": color["black"] | curses.A_BOLD,
            "c": color["cyan"] | curses.A_BOLD}  # the tonal clouds' glow, the cyan slot, landscape only


def catmull_rom(points, lo, hi):
    """x for every integer row from lo to hi through the control points [(row, x)],
    rows increasing, as a Catmull-Rom spline (the ends held)."""
    pts = sorted(points)
    xs = {}
    for r in range(lo, hi + 1):
        i = 0
        while i < len(pts) - 2 and r > pts[i + 1][0]:
            i += 1
        (r0, x0), (r1, x1) = pts[i], pts[i + 1]
        u = 0.0 if r1 == r0 else max(0.0, min(1.0, (r - r0) / (r1 - r0)))
        p0 = pts[i - 1][1] if i > 0 else x0
        p3 = pts[i + 2][1] if i + 2 < len(pts) else x1
        xs[r] = 0.5 * ((2 * x1) + (-p0 + x1 * 0 + x0 * 0 + x1 * 0) * 0 +  # placeholder, replaced below
                       0)
        # the standard form: 0.5 * (2 p1 + (-p0 + p2) u + (2 p0 - 5 p1 + 4 p2 - p3) u^2 + (-p0 + 3 p1 - 3 p2 + p3) u^3)
        p1, p2 = x0, x1
        xs[r] = 0.5 * (2 * p1 + (-p0 + p2) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * u * u
                       + (-p0 + 3 * p1 - 3 * p2 + p3) * u * u * u)
    return xs


def gentle_path(points, lo, hi, limit=2):
    """The spline rounded to columns, its movements scaled down until no row moves
    more than `limit` columns from the one before. Returns {row: x}."""
    base_x = points[0][1]
    scale = 1.0
    for _attempt in range(12):
        scaled = [(r, base_x + (x - base_x) * scale) for r, x in points]
        xs = catmull_rom(scaled, lo, hi)
        path = {r: int(round(x)) for r, x in xs.items()}
        rows = sorted(path)
        if all(abs(path[b] - path[a]) <= limit for a, b in zip(rows, rows[1:])):
            return path
        scale *= 0.85
    return path



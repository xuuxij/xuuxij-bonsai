POTS = {
    "drum":    (pot_drum, 0.45, ("white", "white")),
    "celadon": (pot_celadon, 0.45, ("cyan", "cyan")),
    "teizan":  (pot_teizan, 0.72, ("red", "yellow")),
    "hexagon": (pot_hexagon, 0.37, ("blue", "yellow")),
    "oval":    (pot_oval, 0.72, ("blue", "blue")),
    "bunjin":  (pot_bunjin, 0.90, ("white", "white")),
}
LEAST_POT = {"bunjin": 35, "hexagon": 33}  # the rest 25


def has_shadow(rows):
    return all(p in "s " for p in rows[-1][1])


def fill_body(rows, fill):
    """A planter or stand with its body filled: every blank inside the silhouette of a
    body row becomes `fill` in the body colour; the rim and soil rows, the feet row
    and open rows (a stand's legs) stay as drawn; the cast shadow goes dotted."""
    n = len(rows)
    shadow_at = n - 1 if rows and has_shadow(rows) else None
    feet_at = shadow_at - 1 if shadow_at is not None else n - 1
    out = []
    for i, (text, paint) in enumerate(rows):
        if i < 2 or i == feet_at:
            out.append((text, paint))
        elif i == shadow_at:
            out.append((text.replace("-", "▒"), paint))
        else:
            inked = [k for k, ch in enumerate(text) if ch != " "]
            a, b = (inked[0], inked[-1]) if inked else (0, -1)
            inside = text[a + 1:b]
            if not inside.strip():  # open: a stand's legs
                out.append((text, paint))
                continue
            text = text[:a + 1] + inside.replace(" ", fill) + text[b:]
            paint = paint[:a + 1] + "".join("b" if ch == " " else p for ch, p in zip(inside, paint[a + 1:b])) + paint[b:]
            out.append((text, paint))
    return out


def pot_rows_for(kind, W):
    """A planter's rows at width W: a built-in design stretched to it and filled, a
    user's own as drawn."""
    if kind in USER_POTS:
        return list(USER_POTS[kind][0])
    return fill_body(POTS[kind][0](W), "▒")


def pot_palette(kind):
    return USER_POTS[kind][1] if kind in USER_POTS else POTS[kind][2]


def block_height(kind, stand):
    """Rows the planter takes with its stand (the pot's shadow is dropped on a stand)."""
    rows = pot_rows_for(kind, 41)
    n = len(rows)
    if stand:
        n += len(stand_rows(41, stand)) - (1 if has_shadow(rows) else 0)
    return n



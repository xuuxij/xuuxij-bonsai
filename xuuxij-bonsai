def scale_shape(text, rows_wanted):
    """A shorter copy of a pine: rows sampled evenly (the trunk rows kept at the end)."""
    if rows_wanted >= len(text):
        return text
    n = len(text)
    idx = sorted({int(i * (n - 1) / max(1, rows_wanted - 1)) for i in range(rows_wanted)})
    return [text[i] for i in idx]


def land_stamp(cells, text, paint, y0, x0, H, W):
    for dy, (row, prow) in enumerate(zip(text, paint)):
        for dx, (ch, p) in enumerate(zip(row, prow)):
            if p == " ":
                continue
            y, x = y0 + dy, x0 + dx
            if 0 <= y < H and 0 <= x < W:
                cells[y][x] = (ch, p, cells[y][x][2])


def land_pines(cells, rng, W, H, L):
    """Pines at the two margins, feet on the shore's top row, never alike on both sides:
    one side a tall pine cut by the edge with a small one at its foot, the other a mid
    pine standing a little in from the edge (or a tall one, 1 time in 3). Heights scale
    with the screen; nothing is placed on a screen under 30 rows."""
    if H < 30:
        return
    foot = L["lake_bot"]
    tall_rows = max(8, min(36, int(0.32 * H)))
    mid_rows = max(6, min(22, int(0.19 * H)))
    small_rows = max(4, min(10, int(0.085 * H)))
    tall = (scale_shape(PINE_TALL[0], tall_rows), scale_shape(PINE_TALL[1], tall_rows))
    mid = (scale_shape(PINE_MID[0], mid_rows), scale_shape(PINE_MID[1], mid_rows))
    small = (scale_shape(PINE_SMALL[0], small_rows), scale_shape(PINE_SMALL[1], small_rows))
    tw, mw, sw = len(tall[0][0]), len(mid[0][0]), len(small[0][0])
    tall_side = rng.choice((-1, 1))
    for side in (-1, 1):
        if side == tall_side:
            cut = rng.randint(2, 4)
            tx = -cut if side < 0 else W - tw + cut
            land_stamp(cells, tall[0], tall[1], foot - tall_rows + 1, tx, H, W)
            if rng.random() < 0.7:
                sx = (tx + tw - 2) if side < 0 else (tx - sw + 2)
                land_stamp(cells, small[0], small[1], foot - small_rows + 1, sx, H, W)
        elif rng.random() < 0.33:
            cut = rng.randint(3, 5)
            tx = -cut if side < 0 else W - tw + cut
            land_stamp(cells, tall[0], tall[1], foot - tall_rows + 1, tx, H, W)
        else:
            inset = rng.randint(1, 3)
            mx = inset if side < 0 else W - mw - inset
            land_stamp(cells, mid[0], mid[1], foot - mid_rows + 1, mx, H, W)
            if rng.random() < 0.5:
                sx = (mx + mw - 1) if side < 0 else (mx - sw + 1)
                land_stamp(cells, small[0], small[1], foot - small_rows + 1, sx, H, W)


# ---- the backdrop --------------------------------------------------------------------------

def land_backdrop(W, H, seed, palette=DESIGN_DAY):
    """Rows of cells (char, fg letter, bg letter) for a W x H screen from the seed."""
    rng = random.Random(seed)
    noise = Noise(random.Random(seed * 7919 + 1))
    L = land_layout(W, H)
    P = land_profiles(rng, W, H, L, noise)
    img, layer, lit_map, sp = land_paint(rng, W, H, L, P, noise)
    c0, c1 = L["centre"]

    def quiet(y, x):   # less dither where the tree stands: the lake's centre
        if y >= L["mist_top"] and L["margin"] <= x < W - L["margin"]:
            return 0.5   # a little, so a near-threshold tone softens instead of snapping into blocks
        return 1.0

    cells = land_halftone(img, palette, dither=3.0, quiet=quiet)
    land_ink(cells, img, layer, lit_map, rng, W, H, L, P, noise)
    return cells, {"layout": L, "profiles": P, "layer": layer}


# A paint letter -> (console colour, bold). Backgrounds use the colour alone.
LAND_INK = {"k": (0, False), "B": (4, False), "b": (5, False), "p": (6, False), "g": (7, False),
            "d": (0, True), "i": (4, True), "h": (5, True), "c": (6, True), "W": (7, True)}
# The landscape keeps to five slots (4 5 6 12 15) so the clouds have four of their own
# (7 8 13 14) that stay bright however dim the landscape is: its finer tones are merged
# (soft white and ice into the snow white, rock into the slate, haze into the mid sky).
LAND_REMAP = {"g": "W", "c": "W", "d": "i", "h": "b"}

# What the console shows: the design's colours with the landscape's lightness scaled
# down (the owner wants a dim ground that keeps its contrast and a little of its colour)
# and its chroma kept or scaled, the clouds' greys at their own lightness, the tree's
# and planter's as designed. Scaling lightness in a perceptual space (OKLab) keeps the
# steps between the tones, where scaling the light itself crushed them together. The
# halftone is always made against the design, so the picture keeps its texture.
LANDSCAPE_L = 0.26        # the landscape's lightness, as a share of the design's
LANDSCAPE_CHROMA = 1.0    # and its colour (1 = as designed)
CLOUD_L = 0.41            # the clouds' greys' lightness
LANDSCAPE_SLOTS = (4, 5, 6, 12, 15)
CLOUD_SLOTS = {13: "W", 14: "c", 7: "g", 8: "d"}  # slot -> the tonal clouds' tone


def _lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _srgb(v):
    v = max(0.0, min(1.0, v))
    return int(round((12.92 * v if v <= 0.0031308 else 1.055 * v ** (1 / 2.4) - 0.055) * 255))


def shade(hexcol, k_l, k_c=1.0):
    """`hexcol` with its lightness scaled by k_l and its chroma by k_c (OKLab)."""
    r, g, b = (_lin(c) for c in hex_rgb(hexcol))
    l_ = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m_ = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s_ = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = (0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_) * k_l
    a = (1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_) * k_c
    bb = (0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_) * k_c
    l_ = (L + 0.3963377774 * a + 0.2158037573 * bb) ** 3
    m_ = (L - 0.1055613458 * a - 0.0638541728 * bb) ** 3
    s_ = (L - 0.0894841775 * a - 1.2914855480 * bb) ** 3
    return "#%02x%02x%02x" % (_srgb(4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_),
                              _srgb(-1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_),
                              _srgb(-0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_))


def display_palette(design, cloud_tones):
    out = {}
    for slot, (rgb, use) in design.items():
        if slot in LANDSCAPE_SLOTS:
            out[slot] = (shade(rgb, LANDSCAPE_L, LANDSCAPE_CHROMA), use)
        elif slot in CLOUD_SLOTS:
            out[slot] = (shade(cloud_tones[CLOUD_SLOTS[slot]], CLOUD_L), use)
        else:
            out[slot] = (rgb, use)
    return out


class Backdrop:
    """The landscape as the screen holds it: a character and an attribute per cell, with
    the background slot each cell shows, so everything drawn over it (the tree, the
    planter, the clouds, a falling leaf) takes the cell's own background."""

    HALO_CHARS = set("░▒/\\'.-_~^")  # texture and light strokes give way to the halo

    def __init__(self, W, H, seed, pairs, fallback=False):
        cells, self.meta = land_backdrop(W, H, seed)
        self.W, self.H, self.pairs = W, H, pairs
        self.layer = self.meta["layer"]  # per cell: ' ' open sky, C far range, B main range, A hills, M mist, L lake, S shore, T table
        self.chars, self.fgl, self.bg, self.attr = [], [], [], []
        self.halo = {}  # cell -> how many tree cells it neighbours: a blank margin of paper
        for row in cells:
            chars, fgs, bgs, attrs = [], [], [], []
            for ch, fg, bg in row:
                if fallback:  # a terminal whose palette cannot be set: the standard colours
                    fg, bg = FALLBACK.get(fg, fg), ("B" if bg == "b" else bg)
                else:
                    fg = LAND_REMAP.get(fg, fg)
                colour, bold = LAND_INK[fg]
                under = LAND_INK[bg][0]
                chars.append(ch)
                fgs.append(fg)
                bgs.append(under)
                attrs.append(pairs.attr(colour, under) | (curses.A_BOLD if bold else 0))
            self.chars.append(chars)
            self.fgl.append(fgs)
            self.bg.append(bgs)
            self.attr.append(attrs)

    def cell(self, y, x):
        if (y, x) in self.halo:
            return " ", self.pairs.attr(7, self.bg[y][x])
        return self.chars[y][x], self.attr[y][x]

    def halo_shift(self, cell, d):
        """Counts a neighbouring tree cell in (+1) or out (-1); True when the cell's look
        changed. Solid blocks and the landscape's own ink (slate and black: pines, shore,
        tree tops, gullies) keep their marks."""
        y, x = cell
        if self.chars[y][x] not in self.HALO_CHARS or self.fgl[y][x] in ("k", "i"):
            return False
        before = self.halo.get(cell, 0)
        after = before + d
        if after > 0:
            self.halo[cell] = after
        else:
            self.halo.pop(cell, None)
        return (before > 0) != (after > 0)

    def clear(self, y, x0, x1):
        """Blanks the cells x0..x1 of row y to black: the planter's body sits on black."""
        for x in range(max(0, x0), min(self.W - 1, x1) + 1):
            self.chars[y][x], self.fgl[y][x], self.bg[y][x] = " ", "k", 0
            self.attr[y][x] = self.pairs.attr(0, 0)

    def draw(self, scr):
        """Paints the whole landscape (runs of one attribute at a time)."""
        for y in range(self.H):
            chars, attrs = self.chars[y], self.attr[y]
            x = 0
            while x < self.W:
                k = x + 1
                while k < self.W and attrs[k] == attrs[x]:
                    k += 1
                try:
                    scr.addstr(y, x, "".join(chars[x:k]), attrs[x])
                except curses.error:
                    pass
                x = k


# ---- the sky ---------------------------------------------------------------------------
# Clouds drift behind the tree, drawn only where nothing else is: real cloud kinds in
# the sumi-e manner, an ink outline with a lit top and an empty interior, in three greys
# on the black (W bold white for lit tops, g plain white for bodies, d bold black for
# bases and far clouds). Cirrus high and slow, cumulus lower and faster, a mackerel sky
# or a lenticular now and then, and the one stylised piece: a mist band (kasumi) that
# forms behind the trunk. One wind for the whole run, which the leaf-fall's gusts
# follow two times in three. Designed from the references listed in docs/references.md.

SKY_TICK = 0.25       # seconds between the sky's steps


def paint_for(text, rule):
    return ["".join(" " if ch == " " else rule(y, x, ch, line, len(text)) for x, ch in enumerate(line))
            for y, line in enumerate(text)]


def _heap(y, x, ch, line, rows):
    """Cumulus and lenticular: ~ in the top two rows lit, the base's _ in shadow; a
    filled interior (over a landscape) soft white, its top row lit."""
    if ch == "_" and y == rows - 1:
        return "d"
    if ch == "░":  # a filled interior: soft white, a grey underside
        return "d" if y == rows - 1 else "g"
    return "W" if ch == "~" and y <= 1 else "g"


def heap_fill(text):
    """A cumulus with its inside filled, so it veils what it crosses instead of showing
    it through a wire outline: ░ between the first and last stroke of each row below
    the top one (the outline is the lit top already); the base row's fill is grey."""
    out = []
    for y, row in enumerate(text):
        inked = [x for x, ch in enumerate(row) if ch != " "]
        if y == 0 or len(inked) < 2:
            out.append(row)
            continue
        out.append(row[:inked[0]] + "".join(ch if ch != " " else "░" for ch in row[inked[0]:inked[-1] + 1])
                   + row[inked[-1] + 1:])
    return out


def _heap_soft(y, x, ch, line, rows):
    return "d" if ch == "_" and y == rows - 1 else "g"


def _cirrus(y, x, ch, line, rows):
    """Cirrus, the farthest cloud, carries no bold white: the top two strands plain,
    their tails (. _ in the last cells) and the lower strands dark."""
    tail = ch in "._" and x > len(line.rstrip()) - 8
    return "d" if y >= 2 or tail else "g"


CLOUD_SHAPES = {
    "cumulus": [  # (size, variant A rows, variant B rows)
        (0, ["  .-~~-.  ", " (______) "], [" .-~.-~~-. ", "(_________)"]),
        (1, ["        .-~~~-.._     ", "   .--~'         '-.  ", "  (_________________) "],
            ["      .-~~-.   .-~-.   ", "   .-'      '-'     '-.", "  (___________________)"]),
        (2, ["             .-~~-.               ", "       .-~~-'      '-~~-.         ",
             "   .-~'                  '~-..__  ", "  (______________________________)"],
            ["                  .-~~~-.         ", "       .--~~-.  .'       '-.      ",
             "   .-~'       '-'            '~-. ", "  (______________________________)"]),
    ],
    # Cirrus is drawn for a wind blowing left: the hooked head leads and the strands
    # trail behind it, each lower one set further back; mirrored for a wind blowing right.
    "cirrus": [
        (0, [" ,.-~~~~~--..__ "]),
        (1, [" ,.-~~~~~~~~~~~--..__ ", "    `~~~~~--.._       ", "         `~-.         "]),
        (2, [" ,.-~~~~~~~~~~~~~~~~~--..___ ", "    `~~~~~~~~~~~~--..__      ",
             "          `~~~~--.._         ", "              `-.            "]),
    ],
    "lenticular": ["        _..--~~~~~~~~~--.._      ", "   _.-~'                   '~-._ ",
                   "  '--..___________________..--'  "],
}
MIRROR = str.maketrans("()'`/\\", ")(`'\\/")


def mirrored(rows):
    width = max(len(r) for r in rows)
    return [r.ljust(width)[::-1].translate(MIRROR) for r in rows]


def mackerel_field(rng):
    """A mackerel sky: one-row arcs .-. four columns apart, the rows offset by two
    like a brick lattice of scales, two or three rows, the outer rows shorter so the
    field is a wedge, one arc in five left out; the top row lit, the rest dark."""
    rows = rng.randint(2, 3)
    units = rng.randint(7, 11)  # arcs across the longest row
    width = units * 4 + 5
    text = [[" "] * width for _ in range(rows)]
    mid = (rows - 1) / 2
    for r in range(rows):
        count = units - int(2 * abs(r - mid))
        start = (units - count) // 2 * 4 + (2 if r % 2 else 0)
        for k in range(count):
            if rng.random() < 0.2:
                continue
            x = start + k * 4
            if x + 3 <= width:
                text[r][x:x + 3] = list(".-.")
    text = ["".join(r) for r in text]
    paint = ["".join(" " if ch == " " else ("g" if y == 0 else "d") for ch in r) for y, r in enumerate(text)]
    return text, paint


def stratocumulus_roll(rng):
    units = ["-~~-", "-~~~-", "-~-", "-~~~~-"]
    top = ""
    while len(top) < rng.randint(34, 58):
        top += "." + rng.choice(units) + "." + rng.choice(("__", ".._", "_"))
    top = " _" + top[1:].rstrip("._") + "._ "
    base = "(" + "_" * (len(top) - 2) + ")"
    text = [top, base]
    return text, paint_for(text, _heap_soft)


def mist_band(rng, width):
    """Spear mist (suyari-gasumi): not one line but three to six short bands of dark ~,
    10 to 24 cells each on three or four adjacent rows, each overlapping its
    neighbour by a third, the ends tapered to a dot, a rare ' of grey (the gold
    leaf's dot) inside."""
    rows = rng.randint(3, 4)
    text = [[" "] * width for _ in range(rows)]
    ends = [-99] * rows  # where each row's last band ended: bands on one row keep a gap
    x, row = 0, rng.randrange(rows)
    for _ in range(rng.randint(3, 6)):
        length = min(rng.randint(10, 24), width - x)
        if length < 6:
            break
        line = text[row]
        for i in range(length):
            ch = "." if i in (0, length - 1) else "'" if rng.random() < 1 / 20 else "~"
            if line[x + i] == " ":
                line[x + i] = ch
        ends[row] = x + length
        x += length - length // 3
        free = [r for r in range(rows) if r != row and x >= ends[r] + 4]
        if not free:
            row = min((r for r in range(rows) if r != row), key=lambda r: ends[r])
            x = ends[row] + 4
        else:
            row = rng.choice(free)
    text = ["".join(r) for r in text]
    paint = ["".join(" " if ch == " " else ("g" if ch == "'" else "d") for ch in r) for r in text]
    return text, paint


# ---- the tonal clouds -------------------------------------------------------------------
# The second cloud set, the default over a landscape: clouds made the way the landscape
# is, painted as lit, shaded masses (domes of overlapping half-ellipsoids, roughened by
# noise, lit from above on the landscape's light side, dark under the base) and halftoned
# into ░ ▒ █ in four greys of their own (W c g d: slots 13 14 7 8), in three depths with
# aerial perspective: far clouds faint and never solid, mid ones capped at the glow, near
# ones with solid white crowns. No ink. Designed from the same references as the landscape.

TC_TONES = {"W": "#fbfbf8", "c": "#d2d2ce", "g": "#8c8c88", "d": "#4a4a48"}
TC_COVER = {"░": 0.25, "▒": 0.5, "█": 1.0}
TC_DITHER = 0.06   # in lightness (Y^0.5)
TC_SAMPLES = 4     # sample points per cell side

TC_DEPTHS = {   # cap: brightness ceiling; solid: █ allowed; edge: the soft rim's share of a dome
    # Against mountains at 1 % light even a dim tc_cloud is bright, so the far cap is low:
    # a far tc_cloud peaks at ▒c / ░W dots, a mid one at █c, only a near one reaches █W.
    "far":  {"cap": 0.30, "solid": False, "edge": 0.45},
    "mid":  {"cap": 0.62, "solid": True,  "edge": 0.35},
    "near": {"cap": 1.00, "solid": True,  "edge": 0.30},
}


def tc_luminance(hexs):
    def lin(c):
        c /= 255.0
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (int(hexs[i:i + 2], 16) for i in (1, 3, 5))
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)


TC_LUM = {k: tc_luminance(v) for k, v in TC_TONES.items()}
TC_LADDER = sorted([(0.0, " ", " ")] + [(TC_COVER[ch] * TC_LUM[t], ch, t) for ch in TC_COVER for t in TC_TONES
                                     if not (ch == "█" and t in ("g", "d"))])
TC_LADDER_SOFT = [s for s in TC_LADDER if s[1] != "█"]


def tc_quantize(value, x, y, solid=True):
    """The ladder step nearest the cell's value, dithered."""
    target = math.sqrt(max(0.0, value)) + (BAYER8[y % 8][x % 8] / 64.0 - 0.5) * 2 * TC_DITHER
    ladder = TC_LADDER if solid else TC_LADDER_SOFT
    best = min(ladder, key=lambda s: abs(math.sqrt(s[0]) - target))
    return best[1], best[2]


def tc_halftone(field, W, H, solid=True):
    """field(x, y) -> (coverage, brightness) at a point in cell units; returns rows."""
    text, paint = [], []
    for y in range(H):
        t, p = [], []
        for x in range(W):
            acc = 0.0
            for j in range(TC_SAMPLES):
                for i in range(TC_SAMPLES):
                    a, b = field(x + (i + 0.5) / TC_SAMPLES, y + (j + 0.5) / TC_SAMPLES)
                    acc += a * b
            ch, tone = tc_quantize(acc / (TC_SAMPLES * TC_SAMPLES), x, y, solid)
            t.append(ch)
            p.append(tone)
        text.append("".join(t))
        paint.append("".join(p))
    return text, paint


class TcNoise:
    """Value noise on a lattice, from the tc_cloud's rng."""

    def __init__(self, rng):
        self.grid, self.rng = {}, rng

    def _lat(self, i, j):
        v = self.grid.get((i, j))
        if v is None:
            v = self.grid[(i, j)] = self.rng.random()
        return v

    def at(self, x, y, px, py):
        u, v = x / px, y / py
        i, j = math.floor(u), math.floor(v)
        fu, fv = u - i, v - j
        fu = fu * fu * (3 - 2 * fu)
        fv = fv * fv * (3 - 2 * fv)
        a = self._lat(i, j) * (1 - fu) + self._lat(i + 1, j) * fu
        b = self._lat(i, j + 1) * (1 - fu) + self._lat(i + 1, j + 1) * fu
        return a * (1 - fv) + b * fv


# ---- the lit dome ---------------------------------------------------------------------------

def tc_light_vector(light):
    """x right, y down, z toward the viewer: the sun high to one side, a little in front."""
    L = (0.55 * light, -0.60, 0.58)
    n = math.sqrt(sum(c * c for c in L))
    return tuple(c / n for c in L)


def tc_domes_field(domes, base_y, light, noise, depth, cap_scale=1.0, base_dark=0.65, rough=0.22):
    """domes: (cx, cy, rx, ry) in cells, half-ellipsoids seen from the front, outlines
    roughened by noise; the flat base at row base_y. Returns field(x, y)."""
    L = tc_light_vector(light)
    dp = TC_DEPTHS[depth]
    cap = dp["cap"] * cap_scale

    def field(x, y):
        if y > base_y:
            return 0.0, 0.0
        best, bn = None, 9.0
        wobble = (noise.at(x, y, 2.6, 1.3) - 0.5) * 2 * rough
        for (cx, cy, rx, ry) in domes:
            u, v = (x - cx) / rx, (y - cy) / ry
            e = u * u + v * v + wobble * (0.6 + 0.4 * abs(u))
            if e < bn:
                bn, best = e, (u, v)
        if best is None or bn >= 1.0:
            return 0.0, 0.0
        u, v = best
        h = math.sqrt(max(0.0, 1.0 - bn))
        # the normal, in a space where a cell is twice as tall as it is wide
        nx, ny, nz = u, v * 2.0, h
        nn = math.sqrt(nx * nx + ny * ny + nz * nz) or 1.0
        lit = clamp((nx * L[0] + ny * L[1] + nz * L[2]) / nn)
        b = 0.10 + 0.90 * lit ** 1.5
        b *= 0.88 + 0.24 * (noise.at(x * 1.7, y * 1.1, 3.0, 1.5) - 0.5)   # the body's grain
        b *= 1.0 - base_dark * smoothstep(base_y - 1.1, base_y + 0.05, y)
        a = smoothstep(1.0, 1.0 - dp["edge"], bn)
        return a, clamp(b) * cap
    return field


# ---- the kinds --------------------------------------------------------------------------

TC_CUMULUS_SIZES = {0: (11, 2), 1: (23, 3), 2: (34, 4)}   # (cols, rows)


def tc_cumulus_domes(size, rng):
    W, H = TC_CUMULUS_SIZES[size]
    base = H - 0.12
    n = (3, 5, 7)[size]
    domes = []
    main_x = W * rng.uniform(0.36, 0.64)
    main_rx = W * (0.25, 0.17, 0.13)[size] * rng.uniform(0.9, 1.15)
    domes.append([main_x, base, main_rx, (H - 0.1) * rng.uniform(0.95, 1.0)])
    for i in range(n - 1):
        side = -1 if i % 2 == 0 else 1
        step = (i // 2 + 1)
        cx = main_x + side * (main_rx * rng.uniform(0.7, 1.1) + (step - 1) * W * rng.uniform(0.1, 0.16))
        cx = clamp(cx, W * 0.1, W * 0.9)
        ry = (H - 0.1) * rng.uniform(0.45, 0.8) / (1 + 0.25 * (step - 1))
        rx = W * rng.uniform(0.11, 0.19) / (1 + 0.15 * (step - 1))
        domes.append([cx, base, rx, ry])
    return domes, base, W, H


def tc_cumulus(size, variant, depth, rng, light=-1):
    domes, base, W, H = tc_cumulus_domes(size, rng)
    noise = TcNoise(random.Random(rng.random()))
    if variant == "B":   # one hump grown: the breathing swap
        k = 1 if len(domes) > 1 else 0
        domes[k][2] *= 1.25
        domes[k][3] = min(H - 0.1, domes[k][3] * 1.3)
    return tc_halftone(tc_domes_field(domes, base, light, noise, depth), W, H, TC_DEPTHS[depth]["solid"])


def tc_pair(size, depth, rng, light=-1):
    state = rng.getstate()
    a = tc_cumulus(size, "A", depth, rng, light)
    rng.setstate(state)
    b = tc_cumulus(size, "B", depth, rng, light)
    return a, b


TC_CIRRUS_SIZES = {0: (16, 1), 1: (22, 3), 2: (29, 4)}


def tc_cirrus(size, depth, rng, light=-1):
    """Streaks for a wind blowing left: the hooked head at the left, the strands trailing
    right and drooping; the lower strands set further back and fainter. Far by nature."""
    W, H = TC_CIRRUS_SIZES[size]
    cap = TC_DEPTHS[depth]["cap"]
    strands = []
    for k in range(H):
        x0 = 1 + k * (3 if size else 0) + rng.uniform(0, 1.5)
        length = max(6.0, (W - 2 - x0) * rng.uniform(0.8, 1.0) * (1.0 - 0.1 * k))
        strands.append((x0, k + 0.5, length, 1.0 - 0.2 * k))

    def field(x, y):
        a_best, b_best = 0.0, 0.0
        for (x0, y0, length, glow) in strands:
            t = (x - x0) / length
            if t < -0.05 or t > 1.05:
                continue
            tc = clamp(t)
            yc = y0 - 0.25 * math.sin(math.pi * tc * 0.5) + 0.4 * tc * tc   # hook, then droop
            w = 0.5 * (1.0 - 0.55 * tc) + 0.06
            a = smoothstep(w, w * 0.3, abs(y - yc)) * smoothstep(-0.05, 0.1, t)
            b = glow * ((1.0 - tc) ** 0.7 * 0.9 + 0.1)
            if a * b > a_best * b_best:
                a_best, b_best = a, b
        return a_best, b_best * cap
    return tc_halftone(field, W, H, TC_DEPTHS[depth]["solid"])


def tc_lenticular(depth, rng, light=-1):
    W, H = 33, 3
    cx = W / 2 + rng.uniform(-1, 1)
    domes = [[cx, 2.3, W * 0.47, 2.1], [cx + rng.uniform(-2, 2), 1.05, W * 0.3, 1.0]]
    noise = TcNoise(random.Random(rng.random()))
    f = tc_domes_field(domes, 2.88, light, noise, depth, base_dark=0.5, rough=0.08)
    return tc_halftone(f, W, H, TC_DEPTHS[depth]["solid"])


def tc_roll(width, depth, rng, light=-1):
    """The stratocumulus tc_roll: low domes in a row on a tube, grey only (capped at 0.7)."""
    W, H = max(34, min(58, width)), 2
    domes, x = [], rng.uniform(1.5, 3.5)
    while x < W - 1.5:
        rx = rng.uniform(2.6, 4.2)
        domes.append([x, 1.88, rx, rng.uniform(1.4, 1.9)])
        x += rx * rng.uniform(1.3, 1.7)
    noise = TcNoise(random.Random(rng.random()))
    f = tc_domes_field(domes, 1.9, light, noise, depth, cap_scale=0.7, base_dark=0.6, rough=0.18)
    return tc_halftone(f, W, H, TC_DEPTHS[depth]["solid"])


def tc_mackerel(depth, rng, light=-1):
    """A field of scales: tiny domes on a brick lattice (4 cols, rows offset 2), two or
    three rows, the outer rows shorter (a wedge), a fifth left out, the top row lit."""
    H = rng.randint(2, 3)
    units = rng.randint(8, 12)
    W = min(50, units * 4 + 4)
    cap = TC_DEPTHS[depth]["cap"]
    domes = []
    for r in range(H):
        short = abs(r - (H - 1) / 2) * 2 + 1
        for u in range(units):
            cx = 2 + u * 4 + (2 if r % 2 else 0)
            if u < short / 2 - 0.5 or u > units - short / 2 - 0.5 or rng.random() < 0.2:
                continue
            domes.append([cx, r + 0.55, 1.6, 0.62, r])

    def field(x, y):
        a_best, b_best = 0.0, 0.0
        for (cx, cy, rx, ry, r) in domes:
            u, v = (x - cx) / rx, (y - cy) / ry
            e = u * u + v * v
            if e < 1:
                a = smoothstep(1.0, 0.55, e)
                b = (0.9 if r == 0 else 0.45) * (0.6 + 0.4 * (1 - e)) * (1.0 - 0.3 * clamp(-u * light))
                if a * b > a_best * b_best:
                    a_best, b_best = a, b
        return a_best, b_best * cap
    return tc_halftone(field, W, H, TC_DEPTHS[depth]["solid"])


def tc_mist(width, depth, rng, light=-1):
    """Spear tc_mist over the lake: three or four rows of straight-edged bands, each row's
    band its own length and offset, the ends tapered over six cells, a kirihaku dot one
    cell in fourteen. Thin light: ░ g with ▒ g in the middle, the dots ░ c."""
    W, H = max(40, min(80, width)), rng.randint(3, 4)
    bands = []
    for r in range(H):
        length = int(W * rng.uniform(0.45, 0.8))
        x0 = rng.randint(0, W - length)
        bands.append((x0, x0 + length, rng.uniform(0.09, 0.14)))
    dots = {(r, x) for r in range(H) for x in range(W) if rng.random() < 1 / 14}

    def field(x, y):
        r = int(y)
        if r >= H:
            return 0.0, 0.0
        x0, x1, b = bands[r]
        if x < x0 or x > x1:
            return 0.0, 0.0
        end = min(x - x0, x1 - x)
        if (r, int(x)) in dots:
            return 1.0, 0.17
        return smoothstep(-1, 6, end), b
    return tc_halftone(field, W, H, solid=False)


def tc_cloud(kind, size, variant, depth, rng, light=-1):
    if kind == "cumulus":
        return tc_cumulus(size, variant, depth, rng, light)
    if kind == "cirrus":
        return tc_cirrus(size, depth, rng, light)
    if kind == "lenticular":
        return tc_lenticular(depth, rng, light)
    if kind == "roll":
        return tc_roll(size, depth, rng, light)
    if kind == "mackerel":
        return tc_mackerel(depth, rng, light)
    if kind == "mist":
        return tc_mist(size, depth, rng, light)
    raise ValueError(kind)


# ---- the tc_fade --------------------------------------------------------------------------

def tc_fade(text, paint, p, solid=True):
    """The tc_cloud at tc_fade p: every cell's light scaled by p and put back on the ladder with
    the cell's own dither offset. Call it on the full tc_cloud each step."""
    out_t, out_p = [], []
    for y, (row, prow) in enumerate(zip(text, paint)):
        t, pp = [], []
        for x, (ch, tone) in enumerate(zip(row, prow)):
            if ch == " ":
                c2, t2 = " ", " "
            else:
                c2, t2 = tc_quantize(TC_COVER[ch] * TC_LUM[tone] * p, x, y, solid)
            t.append(c2)
            pp.append(t2)
        out_t.append("".join(t))
        out_p.append("".join(pp))
    return out_t, out_p



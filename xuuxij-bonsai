A_COLOR_MASK = curses.A_COLOR & 0xFFFFFFFF
PAIR_SHIFT = (A_COLOR_MASK & -A_COLOR_MASK).bit_length() - 1  # where curses keeps the pair number


class Pairs:
    """Colour pairs made on demand: (foreground, background) -> the curses attribute, so
    a thing drawn over the landscape takes the background of the cell it lands on. Black
    and the terminal's default background are one pair."""

    def __init__(self, live=True):
        self.live = live   # False in the tools, which record attributes without a terminal
        self.default = -1  # the background a pair with none gets
        self.table, self.of = {}, {}

    def attr(self, fg, bg=-1):
        bg = self.default if bg in (0, -1) else bg
        n = self.table.get((fg, bg))
        if n is None:
            n = len(self.table) + 1
            if self.live and n >= curses.COLOR_PAIRS:  # out of pairs: lose the background
                return self.attr(fg, -1) if bg != self.default else 0
            self.table[(fg, bg)] = n
            self.of[n] = (fg, bg)
            if self.live:
                curses.init_pair(n, fg, bg)
        return (n << PAIR_SHIFT) & A_COLOR_MASK

    def on(self, attr, bg):
        """`attr` with its foreground kept, over the background `bg`."""
        if bg <= 0:
            return attr
        n = (attr & A_COLOR_MASK) >> PAIR_SHIFT
        fg = self.of[n][0] if n in self.of else 7
        return (attr & ~A_COLOR_MASK) | self.attr(fg, bg)


